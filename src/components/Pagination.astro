---
export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

function pageUrl(n: number): string {
  if (n <= 1) return baseUrl;
  return `${baseUrl.replace(/\/$/, '')}/${n}`;
}

function range(start: number, end: number): number[] {
  return Array.from({ length: end - start + 1 }, (_, i) => start + i);
}

// Build visible page numbers with ellipsis
function buildPages(): (number | 'ellipsis')[] {
  const pages: (number | 'ellipsis')[] = [];

  if (totalPages <= 7) {
    return range(1, totalPages);
  }

  pages.push(1);

  if (currentPage > 3) {
    pages.push('ellipsis');
  }

  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (currentPage < totalPages - 2) {
    pages.push('ellipsis');
  }

  pages.push(totalPages);

  return pages;
}

const pageNumbers = buildPages();
const from = (currentPage - 1) * 48 + 1;
const to = Math.min(currentPage * 48, 99999);
---

<!-- Page info -->
<p class="text-sm text-slate-500 dark:text-slate-400 text-center mb-4">
  <span data-i18n="pagination.page">Page</span> {currentPage} <span data-i18n="pagination.of">of</span> {totalPages}
</p>

<nav class="flex items-center justify-center gap-1.5" aria-label="Pagination">
  <!-- Previous -->
  <a
    href={currentPage > 1 ? pageUrl(currentPage - 1) : '#'}
    class={`
      inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200
      ${currentPage > 1
        ? 'text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400'
        : 'text-slate-300 dark:text-slate-600 pointer-events-none'}
    `}
    aria-disabled={currentPage <= 1}
    tabindex={currentPage <= 1 ? '-1' : '0'}
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <span class="hidden sm:inline" data-i18n="pagination.prev">Prev</span>
  </a>

  <!-- Page numbers -->
  {pageNumbers.map(p => (
    p === 'ellipsis' ? (
      <span class="px-2 py-2 text-sm text-slate-400 dark:text-slate-500 select-none">…</span>
    ) : (
      <a
        href={p === currentPage ? '#' : pageUrl(p)}
        class={`
          inline-flex items-center justify-center min-w-[2.25rem] h-9 px-2 text-sm font-medium rounded-lg transition-all duration-200
          ${p === currentPage
            ? 'bg-indigo-600 text-white shadow-md shadow-indigo-200 dark:shadow-indigo-900/30 cursor-default'
            : 'text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400'}
        `}
        aria-current={p === currentPage ? 'page' : undefined}
      >
        {p}
      </a>
    )
  ))}

  <!-- Next -->
  <a
    href={currentPage < totalPages ? pageUrl(currentPage + 1) : '#'}
    class={`
      inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200
      ${currentPage < totalPages
        ? 'text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400'
        : 'text-slate-300 dark:text-slate-600 pointer-events-none'}
    `}
    aria-disabled={currentPage >= totalPages}
    tabindex={currentPage >= totalPages ? '-1' : '0'}
  >
    <span class="hidden sm:inline" data-i18n="pagination.next">Next</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </a>
</nav>
