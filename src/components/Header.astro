---
const categories = [
  { name: 'Match-3', slug: 'match-3' },
  { name: 'Puzzle', slug: 'puzzle' },
  { name: 'Merge', slug: 'merge' },
  { name: 'Arcade', slug: 'arcade' },
  { name: 'Casual', slug: 'casual' },
  { name: 'Strategy', slug: 'strategy' },
  { name: 'Adventure', slug: 'adventure' },
  { name: 'Word', slug: 'word' },
  { name: 'Card', slug: 'card' },
  { name: 'Board', slug: 'board' },
  { name: 'Hidden Object', slug: 'hidden-object' },
  { name: 'Sports', slug: 'sports' },
  { name: 'Racing', slug: 'racing' },
  { name: 'Action', slug: 'action' },
  { name: 'Fighting', slug: 'fighting' },
  { name: 'Idle', slug: 'idle' },
  { name: 'Multiplayer', slug: 'multiplayer' },
];
---

<header class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 sticky top-0 z-50">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-xl font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <span>Chill Arcade</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/" class="text-base font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
        <div id="categories-dropdown" class="relative">
          <button id="cat-toggle" class="text-base font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center gap-1">
            <span data-i18n="nav.categories">Categories</span>
            <svg id="cat-arrow" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div id="cat-menu" class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-[520px] bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 opacity-0 invisible transition-all duration-200 p-4">
            <div class="grid grid-cols-3 gap-1">
              {categories.map(cat => (
                <a href={`/category/${cat.slug}`} data-i18n={`cat.${cat.slug}`} class="block px-3 py-2 rounded-lg text-sm text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  {cat.name}
                </a>
              ))}
            </div>
          </div>
        </div>
        <a href="/blog" class="text-base font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.guides">Guides</a>
      </nav>

      <!-- Right: Favorites, Recent, Language -->
      <div class="flex items-center gap-3 ml-auto">
        <div class="flex items-center gap-0.5">
          <a href="/favorites" class="hidden md:flex items-center justify-center w-9 h-9 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-red-500 dark:hover:text-red-400 transition-all" aria-label="Favorites" title="My Favorites">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </a>
          <a href="/recent" class="hidden md:flex items-center justify-center w-9 h-9 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-500 dark:hover:text-indigo-400 transition-all" aria-label="Recently Played" title="Recently Played">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </a>
        </div>

        <!-- Language Selector -->
        <div class="relative">
          <button id="lang-selector-btn" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors border border-slate-200 dark:border-slate-600" aria-label="Select language">
          <img id="lang-flag" src="/flags/us.svg" alt="" class="w-5 h-4 rounded-sm object-cover shrink-0" width="20" height="15" />
          <span id="lang-name">English</span>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <!-- Desktop dropdown -->
        <div id="lang-selector-menu" class="hidden md:absolute md:top-full md:right-0 md:left-auto md:mt-1 md:w-[360px] md:max-h-[440px] md:overflow-y-auto bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 p-3 z-[100]">
          <div class="text-xs font-semibold text-slate-400 dark:text-slate-500 mb-2 px-1">Select Language</div>
          <div class="grid grid-cols-3 gap-1.5" id="lang-list">
            {[
              { code: 'en', country: 'us', name: 'English', native: 'English' },
              { code: 'es', country: 'es', name: 'Spanish', native: 'Español' },
              { code: 'fr', country: 'fr', name: 'French', native: 'Français' },
              { code: 'de', country: 'de', name: 'German', native: 'Deutsch' },
              { code: 'pt', country: 'br', name: 'Portuguese', native: 'Português' },
              { code: 'it', country: 'it', name: 'Italian', native: 'Italiano' },
              { code: 'nl', country: 'nl', name: 'Dutch', native: 'Nederlands' },
              { code: 'pl', country: 'pl', name: 'Polish', native: 'Polski' },
              { code: 'sv', country: 'se', name: 'Swedish', native: 'Svenska' },
              { code: 'ru', country: 'ru', name: 'Russian', native: 'Русский' },
              { code: 'tr', country: 'tr', name: 'Turkish', native: 'Türkçe' },
              { code: 'ar', country: 'sa', name: 'Arabic', native: 'العربية' },
              { code: 'ja', country: 'jp', name: 'Japanese', native: '日本語' },
              { code: 'ko', country: 'kr', name: 'Korean', native: '한국어' },
              { code: 'zh', country: 'cn', name: 'Chinese', native: '简体中文' },
              { code: 'zh-tw', country: 'tw', name: 'Chinese (TW)', native: '繁體中文' },
            ].map(lang => (
              <button data-lang-code={lang.code} class="flex items-center gap-2 px-3 py-2 rounded-xl text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50 transition-all text-left">
                <img src={`/flags/${lang.country}.svg`} alt="" class="w-6 h-5 rounded-sm object-cover shrink-0" width="24" height="20" loading="lazy" />
                <div class="flex flex-col leading-tight">
                  <span class="font-medium text-xs">{lang.native}</span>
                  <span class="text-[10px] text-slate-400">{lang.name}</span>
                </div>
              </button>
            ))}
          </div>
        </div>
        <!-- Mobile full-screen overlay -->
        <div id="lang-overlay" class="hidden fixed inset-0 z-[100] bg-black/40 backdrop-blur-sm md:hidden">
          <div class="absolute inset-x-0 bottom-0 top-[18%] bg-white dark:bg-slate-800 rounded-t-3xl shadow-2xl overflow-y-auto p-5 pb-8">
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm font-semibold text-slate-500 dark:text-slate-400">Select Language</span>
              <button id="lang-overlay-close" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <div class="grid grid-cols-2 gap-2">
              {[
                { code: 'en', country: 'us', name: 'English', native: 'English' },
                { code: 'es', country: 'es', name: 'Spanish', native: 'Español' },
                { code: 'fr', country: 'fr', name: 'French', native: 'Français' },
                { code: 'de', country: 'de', name: 'German', native: 'Deutsch' },
                { code: 'pt', country: 'br', name: 'Portuguese', native: 'Português' },
                { code: 'it', country: 'it', name: 'Italian', native: 'Italiano' },
                { code: 'nl', country: 'nl', name: 'Dutch', native: 'Nederlands' },
                { code: 'pl', country: 'pl', name: 'Polish', native: 'Polski' },
                { code: 'sv', country: 'se', name: 'Swedish', native: 'Svenska' },
                { code: 'ru', country: 'ru', name: 'Russian', native: 'Русский' },
                { code: 'tr', country: 'tr', name: 'Turkish', native: 'Türkçe' },
                { code: 'ar', country: 'sa', name: 'Arabic', native: 'العربية' },
                { code: 'ja', country: 'jp', name: 'Japanese', native: '日本語' },
                { code: 'ko', country: 'kr', name: 'Korean', native: '한국어' },
                { code: 'zh', country: 'cn', name: 'Chinese', native: '简体中文' },
                { code: 'zh-tw', country: 'tw', name: 'Chinese (TW)', native: '繁體中文' },
              ].map(lang => (
                <button data-lang-code={lang.code} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50 transition-all text-left active:scale-[0.98]">
                  <img src={`/flags/${lang.country}.svg`} alt="" class="w-6 h-5 rounded-sm object-cover shrink-0" width="24" height="20" />
                  <div class="flex flex-col leading-tight min-w-0">
                    <span class="font-medium text-xs truncate">{lang.native}</span>
                    <span class="text-[10px] text-slate-400 truncate">{lang.name}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>  <!-- end right wrapper -->
    </div>
  </div>

</header>

<script>
  // Language selector: desktop dropdown (from Layout) + mobile overlay
  (function() {
    var overlay = document.getElementById('lang-overlay');
    var closeBtn = document.getElementById('lang-overlay-close');
    var triggerBtn = document.getElementById('lang-selector-btn');
    if (!overlay || !triggerBtn) return;

    // Move overlay to body so header's backdrop-filter doesn't break fixed positioning
    document.body.appendChild(overlay);

    // Toggle overlay on mobile (md: hidden)
    triggerBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (window.innerWidth >= 768) return; // desktop uses dropdown from Layout
      var isOpen = !overlay.classList.contains('hidden');
      if (isOpen) {
        closeOverlay();
      } else {
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });

    function closeOverlay() {
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
    }

    if (closeBtn) closeBtn.addEventListener('click', closeOverlay);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeOverlay();
    });

    // Language selection inside overlay
    overlay.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-lang-code]');
      if (!btn) return;
      var code = btn.getAttribute('data-lang-code');
      if (window.__applyLang) window.__applyLang(code);
      closeOverlay();
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) closeOverlay();
    });
  })();

  // Categories dropdown — hover (desktop) + click (touch)
  const catToggle = document.getElementById('cat-toggle');
  const catMenu = document.getElementById('cat-menu');
  const catArrow = document.getElementById('cat-arrow');
  if (catToggle && catMenu) {
    catToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !catMenu.classList.contains('invisible');
      catMenu.classList.toggle('invisible');
      catMenu.classList.toggle('opacity-0');
      catMenu.classList.toggle('opacity-100');
      if (catArrow) catArrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
    });
    const container = document.getElementById('categories-dropdown');
    if (container) {
      container.addEventListener('mouseenter', () => {
        catMenu.classList.remove('invisible', 'opacity-0');
        catMenu.classList.add('opacity-100');
        if (catArrow) catArrow.style.transform = 'rotate(180deg)';
      });
      container.addEventListener('mouseleave', () => {
        catMenu.classList.add('invisible', 'opacity-0');
        catMenu.classList.remove('opacity-100');
        if (catArrow) catArrow.style.transform = 'rotate(0deg)';
      });
    }
    document.addEventListener('click', (e) => {
      if (!catMenu.classList.contains('invisible') && !catToggle.contains(e.target) && !catMenu.contains(e.target)) {
        catMenu.classList.add('invisible', 'opacity-0');
        catMenu.classList.remove('opacity-100');
        if (catArrow) catArrow.style.transform = 'rotate(0deg)';
      }
    });
  }
</script>
