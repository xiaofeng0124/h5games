---
import GameCard from './GameCard.astro';
import type { Game } from '../data/games';

export interface Props {
  games: Game[];
  cols?: 2 | 3 | 4 | 8;
  title?: string;
  compact?: boolean;
}

const { games, cols = 4, title, compact = false } = Astro.props;
const gridCols = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
  8: 'grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8',
};
---

<div>
  {title && <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-6">{title}</h2>}
  <div class={`grid ${gridCols[cols]} ${compact ? 'gap-2' : 'gap-4 sm:gap-6'}`}>
    {games.map((game, i) => (
      <GameCard
        slug={game.slug}
        title={game.title}
        category={game.category}
        image={game.image}
        description={game.shortDescription}
        difficulty={game.difficulty}
        iframeUrl={game.iframeUrl}
        priority={i < 2}
        compact={compact}
      />
    ))}
  </div>
</div>
