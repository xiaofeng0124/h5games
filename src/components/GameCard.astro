---
export interface Props {
  slug: string;
  title: string;
  category: string;
  image?: string;
  description: string;
  difficulty?: string;
  iframeUrl?: string;
}

const { slug, title, category, image, description, difficulty, iframeUrl } = Astro.props;
const emojiMap: Record<string, string> = {
  'match-3': '💎', 'puzzle': '🧩', 'merge': '🔄', 'casual': '🎮', 'arcade': '🕹️', 'word': '📝', 'card': '🃏', 'hidden-object': '🔍',
};
const difficultyColor: Record<string, string> = {
  easy: 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300',
  medium: 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300',
  hard: 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300',
};
---

<a
  href={`/games/${slug}`}
  class="group block bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-600 transition-all duration-300"
  data-iframe-url={iframeUrl || ''}
>
  <!-- Thumbnail -->
  <div class="game-thumb relative aspect-video bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-indigo-900 dark:to-purple-900 flex items-center justify-center text-6xl overflow-hidden">
    {image
      ? <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
      : <span>{emojiMap[category] || '🎮'}</span>
    }
    <!-- Preview container: real game loads here on hover -->
    <div class="game-preview absolute inset-0 w-full h-full z-10 hidden"></div>
    <!-- Play overlay -->
    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 flex items-center justify-center transition-colors duration-300 z-20">
      <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 w-14 h-14 bg-white/90 rounded-full flex items-center justify-center shadow-lg">
        <svg class="w-6 h-6 text-indigo-600 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </div>
    </div>
  </div>
  <!-- Info -->
  <div class="p-4">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-2 py-1 rounded-full capitalize">{category}</span>
      {difficulty && (
        <span class={`text-xs font-medium px-2 py-1 rounded-full ${difficultyColor[difficulty] || difficultyColor.easy}`}>{difficulty}</span>
      )}
    </div>
    <h3 class="font-semibold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1">{title}</h3>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">{description}</p>
  </div>
</a>

<script>
  document.querySelectorAll('[data-iframe-url]').forEach(card => {
    const iframeUrl = card.dataset.iframeUrl;
    if (!iframeUrl) return;

    const preview = card.querySelector('.game-preview');
    const thumb = card.querySelector('.game-thumb');
    let iframe = null;
    let hoverTimer = null;

    const loadPreview = () => {
      if (iframe) return;
      iframe = document.createElement('iframe');
      iframe.src = iframeUrl;
      iframe.className = 'w-full h-full border-0';
      iframe.loading = 'lazy';
      iframe.allow = 'autoplay; fullscreen';
      preview.appendChild(iframe);
      preview.classList.remove('hidden');
    };

    const unloadPreview = () => {
      if (iframe) {
        iframe.remove();
        iframe = null;
      }
      preview.classList.add('hidden');
    };

    card.addEventListener('mouseenter', () => {
      clearTimeout(hoverTimer);
      hoverTimer = setTimeout(loadPreview, 200);
    });

    card.addEventListener('mouseleave', () => {
      clearTimeout(hoverTimer);
      unloadPreview();
    });
  });
</script>
