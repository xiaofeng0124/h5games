---
export interface Props {
  slug: string;
  title: string;
  category: string;
  image?: string;
  description: string;
  difficulty?: string;
  iframeUrl?: string;
  priority?: boolean;
  compact?: boolean;
}

const { slug, title, category, image, description, difficulty, iframeUrl, priority, compact } = Astro.props;
const emojiMap: Record<string, string> = {
  'match-3': '🍬', 'puzzle': '🧩', 'merge': '🧪', 'casual': '🎮', 'arcade': '👾', 'word': '🔤', 'card': '🃏', 'hidden-object': '🔍',
};
---

{
  compact ? (
    <a
      href={`/games/${slug}`}
      class="gc"
    >
      <div class="gc-thumb">
        {image
          ? <img src={image} alt={title} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} onerror="this.style.display='none'" />
          : <span class="gc-icon">{emojiMap[category] || '🎮'}</span>
        }
        <!-- iframe preview container -->
        <div class="game-preview absolute inset-0 w-full h-full z-10 hidden opacity-0 transition-opacity duration-200"></div>
        <div class="gc-overlay">
          <div class="gc-play">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>
        </div>
      </div>
      <span class="gc-title">{title}</span>
    </a>
  ) : (
    <a
      href={`/games/${slug}`}
      class="group block bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-600 transition-all duration-200"
      data-iframe-url={iframeUrl || ''}
      data-category={category}
      data-title={title.toLowerCase()}
      data-description={description.toLowerCase()}
      data-difficulty={difficulty || ''}
    >
      <!-- Thumbnail -->
      <div class="game-thumb relative aspect-video bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-indigo-900 dark:to-purple-900 flex items-center justify-center text-6xl overflow-hidden">
        {image
          ? <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover will-change-transform transition-transform duration-300 group-hover:scale-150" loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'low'} width="320" height="180" onerror="this.style.display='none'" />
          : <span>{emojiMap[category] || '🎮'}</span>
        }
        {image && <span class="z-0">{emojiMap[category] || '🎮'}</span>}
        <!-- Preview container: real game loads here on hover -->
        <div class="game-preview absolute inset-0 w-full h-full z-10 hidden opacity-0 transition-opacity duration-200"></div>
        <!-- Play overlay -->
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 flex items-center justify-center transition-colors duration-200 z-20">
          <div class="gc-play-nc opacity-0 group-hover:opacity-100 transition-all duration-200 w-14 h-14 bg-white/90 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-indigo-600 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>
        </div>
      </div>
      <!-- Info -->
      <div class="p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-2 py-1 rounded-full capitalize">{category}</span>
          {difficulty && (
            <span class="text-xs font-medium px-2 py-1 rounded-full bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300">{difficulty}</span>
          )}
        </div>
        <h3 class="font-semibold text-slate-800 dark:text-[#ea580c] group-hover:text-indigo-600 dark:group-hover:text-[#f97316] transition-colors duration-200 line-clamp-1">{title}</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">{description}</p>
      </div>
    </a>
  )
}
</a>

<script>
  document.querySelectorAll('[data-iframe-url]').forEach((card) => {
    const iframeUrl = card.dataset.iframeUrl;
    if (!iframeUrl) return;

    const previewEl = card.querySelector('.game-preview');
    if (!previewEl) return;

    let iframeInstance = null;
    let enterTimer = null;
    let leaveTimer = null;

    const loadPreview = () => {
      if (iframeInstance) return;
      iframeInstance = document.createElement('iframe');
      iframeInstance.src = iframeUrl;
      iframeInstance.className = 'w-full h-full border-0';
      iframeInstance.loading = 'lazy';
      iframeInstance.allow = 'autoplay; fullscreen';
      iframeInstance.sandbox = 'allow-scripts allow-same-origin';
      iframeInstance.onerror = () => {
        iframeInstance.remove();
        iframeInstance = null;
      };
      previewEl.appendChild(iframeInstance);
      previewEl.classList.remove('hidden');
      requestAnimationFrame(() => {
        previewEl.style.opacity = '1';
      });
    };

    const unloadPreview = () => {
      previewEl.style.opacity = '0';
      // Remove iframe quickly after fade starts
      leaveTimer = setTimeout(() => {
        if (iframeInstance) {
          iframeInstance.remove();
          iframeInstance = null;
        }
        previewEl.classList.add('hidden');
      }, 400);
    };

    card.addEventListener('mouseenter', () => {
      clearTimeout(enterTimer);
      clearTimeout(leaveTimer);
      enterTimer = setTimeout(loadPreview, 500);
    });

    card.addEventListener('mouseleave', () => {
      clearTimeout(enterTimer);
      if (iframeInstance) {
        unloadPreview();
      }
    });
  });
</script>
