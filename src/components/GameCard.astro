---
export interface Props {
  slug: string;
  title: string;
  category: string;
  image?: string;
  description: string;
  difficulty?: string;
}

const { slug, title, category, image, description, difficulty } = Astro.props;
const emojiMap: Record<string, string> = {
  'match-3': '💎', 'puzzle': '🧩', 'merge': '🔄', 'casual': '🎮', 'arcade': '🕹️', 'word': '📝', 'card': '🃏', 'hidden-object': '🔍',
};
const difficultyColor: Record<string, string> = {
  easy: 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300',
  medium: 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300',
  hard: 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300',
};
---

<a href={`/games/${slug}`} class="group block bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-600 transition-all duration-300">
  <!-- Thumbnail -->
  <div class="aspect-video bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-indigo-900 dark:to-purple-900 flex items-center justify-center text-6xl group-hover:scale-105 transition-transform duration-300">
    {image
      ? <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
      : <span>{emojiMap[category] || '🎮'}</span>
    }
  </div>
  <!-- Info -->
  <div class="p-4">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-2 py-1 rounded-full capitalize">{category}</span>
      {difficulty && (
        <span class={`text-xs font-medium px-2 py-1 rounded-full ${difficultyColor[difficulty] || difficultyColor.easy}`}>{difficulty}</span>
      )}
    </div>
    <h3 class="font-semibold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1">{title}</h3>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">{description}</p>
  </div>
</a>
