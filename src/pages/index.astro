---
import Layout from '../layouts/Layout.astro';
import GameGrid from '../components/GameGrid.astro';
import games from '../data/games.json' with { type: 'json' };
import categories from '../data/categories.json' with { type: 'json' };

const featured = games.filter(g => g.featured).slice(0, 8);
const featuredSlugs = new Set(featured.map(g => g.slug));
const allGames = games.filter(g => !featuredSlugs.has(g.slug)).slice(0, 12);
const categoryEntries = Object.entries(categories) as [string, { name: string; description: string; icon: string }][];
---

<Layout title="Free Relaxing Browser Games - Play Online Instantly">
  <section class="relative text-center py-12 md:py-24 overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-24 -left-24 w-64 h-64 bg-indigo-200/30 dark:bg-indigo-800/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-purple-200/30 dark:bg-purple-800/20 rounded-full blur-3xl"></div>
    </div>
    <!-- Floating game icons -->
    <div class="absolute inset-0 pointer-events-none hidden md:block">
      <span class="absolute top-12 left-[10%] text-4xl opacity-20" style="animation: bounce 3s infinite">💎</span>
      <span class="absolute top-20 right-[15%] text-3xl opacity-20" style="animation: pulse 3s infinite">🧩</span>
      <span class="absolute bottom-16 left-[20%] text-5xl opacity-10" style="animation: bounce 3s infinite 0.5s">🔄</span>
      <span class="absolute bottom-20 right-[10%] text-4xl opacity-15" style="animation: pulse 3s infinite 0.3s">🕹️</span>
      <span class="absolute top-1/2 left-[5%] text-3xl opacity-10" style="animation: bounce 3s infinite 0.8s">🎮</span>
      <span class="absolute top-1/3 right-[8%] text-2xl opacity-15" style="animation: pulse 3s infinite 0.6s">🃏</span>
    </div>
    <h1 class="relative text-4xl md:text-6xl font-extrabold text-slate-800 dark:text-slate-100 mb-4">
      Instant Play, Zero Hassle
      <span class="block text-indigo-600 dark:text-indigo-400 mt-2">100% Free Browser Games</span>
    </h1>
    <p class="relative text-lg md:text-xl text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mb-8">
      No downloads. No signups. No paywalls. Just click and play hundreds of casual games — match-3 puzzles, merge adventures, brain teasers, and more.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="#games" class="px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 dark:shadow-indigo-900/30 transition-all hover:scale-105">
        Browse Games
      </a>
      <a href="/category/puzzle" class="px-8 py-3 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold rounded-xl border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-600 transition-all hover:scale-105">
        Puzzle Games
      </a>
    </div>
  </section>

  <!-- Search & Filter -->
  <section class="mb-8">
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="search-input" placeholder="Search games..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-all" />
        </div>
        <select id="category-filter" class="px-4 py-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-all">
          <option value="">All Categories</option>
          {categoryEntries.map(([slug, cat]) => (
            <option value={slug}>{cat.name}</option>
          ))}
        </select>
        <select id="difficulty-filter" class="px-4 py-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-all">
          <option value="">All Difficulties</option>
          <option value="easy">Easy</option>
          <option value="medium">Medium</option>
          <option value="hard">Hard</option>
        </select>
      </div>
      <div id="search-results-info" class="mt-2 text-xs text-slate-400 hidden">
        <span id="result-count">0</span> games found
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-6">Browse by Category</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-8 gap-3">
      {categoryEntries.map(([slug, cat]) => (
        <a href={`/category/${slug}`} class="flex flex-col items-center p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-600 hover:shadow-md transition-all group">
          <span class="text-3xl mb-2 group-hover:scale-110 transition-transform">{cat.icon}</span>
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300 text-center">{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Games -->
  <section class="mb-12" id="games">
    <GameGrid games={featured} cols={4} title="🔥 Featured Games" />
  </section>

  <!-- Latest Games -->
  <section class="mb-12">
    <GameGrid games={allGames} cols={4} title="🎮 All Games" />
  </section>

  <!-- Why section -->
  <section class="mb-12 p-8 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-8 text-center">Why Play on Chill Arcade?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="text-4xl mb-3">⚡</div>
        <h3 class="font-semibold text-slate-700 dark:text-slate-300 mb-2">Instant Play</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">No downloads, no installations. Games load instantly in your browser.</p>
      </div>
      <div class="text-center">
        <div class="text-4xl mb-3">🎯</div>
        <h3 class="font-semibold text-slate-700 dark:text-slate-300 mb-2">Always Free</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Every game is completely free to play. No paywalls, no subscriptions.</p>
      </div>
      <div class="text-center">
        <div class="text-4xl mb-3">📱</div>
        <h3 class="font-semibold text-slate-700 dark:text-slate-300 mb-2">Mobile Friendly</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">All games work perfectly on your phone. Play anywhere, anytime.</p>
      </div>
    </div>
  </section>

  <!-- Feedback Form -->
  <section class="mb-8 py-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
    <div class="px-6 sm:px-8">
      <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-0.5 text-center">We'd Love to Hear From You</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mb-2 text-center">Have a suggestion or found a bug? Drop us a message!</p>
    </div>
    <form id="feedback-form" class="px-6 sm:px-8">
      <div class="flex gap-2 items-start">
        <input type="text" id="feedback-name" placeholder="Your name (optional)" maxlength="50"
          class="w-1/3 shrink-0 px-3 py-1.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-all" />
        <textarea id="feedback-message" rows="3" placeholder="Your message..." maxlength="2000" required
          class="flex-1 px-3 py-1.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition-all resize-none"></textarea>
        <button type="submit" id="feedback-submit"
          class="px-5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-all hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed text-sm shrink-0">
          Send
        </button>
      </div>
      <div class="flex items-center justify-between mt-1">
        <span id="feedback-char-count" class="text-xs text-slate-400">0/2000</span>
        <div>
          <div id="feedback-success" class="hidden inline-block px-2 py-0.5 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-xs rounded-lg">
            Thanks for your feedback!
          </div>
          <div id="feedback-error" class="hidden inline-block px-2 py-0.5 bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 text-xs rounded-lg"></div>
        </div>
      </div>
    </form>
  </section>

  <!-- Schema structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Chill Arcade",
    "url": "https://chillarcade.io",
    "description": "Play free relaxing online games in your browser. No download, no signup, instant fun!",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://chillarcade.io/games/{search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
</Layout>

<script>
  const searchInput = document.getElementById('search-input');
  const categoryFilter = document.getElementById('category-filter');
  const difficultyFilter = document.getElementById('difficulty-filter');
  const resultsInfo = document.getElementById('search-results-info');
  const resultCount = document.getElementById('result-count');
  const gameCards = document.querySelectorAll('[data-category]');

  function filterGames() {
    const query = searchInput.value.trim().toLowerCase();
    const category = categoryFilter.value;
    const difficulty = difficultyFilter.value;
    let visibleCount = 0;

    gameCards.forEach(card => {
      const matchCategory = !category || card.dataset.category === category;
      const matchDifficulty = !difficulty || card.dataset.difficulty === difficulty;
      const matchSearch = !query ||
        card.dataset.title.includes(query) ||
        card.dataset.description.includes(query) ||
        card.dataset.category.includes(query);

      if (matchCategory && matchDifficulty && matchSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (query || category || difficulty) {
      resultsInfo.classList.remove('hidden');
      resultCount.textContent = visibleCount;
    } else {
      resultsInfo.classList.add('hidden');
    }
  }

  searchInput.addEventListener('input', filterGames);
  categoryFilter.addEventListener('change', filterGames);
  difficultyFilter.addEventListener('change', filterGames);

  // Feedback form
  const feedbackForm = document.getElementById('feedback-form');
  const feedbackName = document.getElementById('feedback-name');
  const feedbackMessage = document.getElementById('feedback-message');
  const feedbackSubmit = document.getElementById('feedback-submit');
  const feedbackSuccess = document.getElementById('feedback-success');
  const feedbackError = document.getElementById('feedback-error');
  const charCount = document.getElementById('feedback-char-count');

  if (feedbackMessage && charCount) {
    feedbackMessage.addEventListener('input', () => {
      charCount.textContent = `${feedbackMessage.value.length}/2000`;
    });
  }

  feedbackForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = feedbackMessage.value.trim();
    if (!message || message.length < 2) return;

    feedbackSubmit.disabled = true;
    feedbackSubmit.textContent = 'Sending...';
    feedbackSuccess.classList.add('hidden');
    feedbackError.classList.add('hidden');

    try {
      const res = await fetch('/api/feedback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: feedbackName.value.trim(),
          message,
        }),
      });
      if (res.ok) {
        feedbackForm.reset();
        charCount.textContent = '0/2000';
        feedbackSuccess.classList.remove('hidden');
        setTimeout(() => feedbackSuccess.classList.add('hidden'), 4000);
      } else {
        const data = await res.json();
        feedbackError.textContent = data.error || 'Failed to send. Try again.';
        feedbackError.classList.remove('hidden');
      }
    } catch {
      feedbackError.textContent = 'Network error. Please try again later.';
      feedbackError.classList.remove('hidden');
    } finally {
      feedbackSubmit.disabled = false;
      feedbackSubmit.textContent = 'Send Feedback';
    }
  });
</script>
