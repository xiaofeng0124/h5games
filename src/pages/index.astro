import Layout from '../layouts/Layout.astro';
import SearchAutocomplete from '../components/SearchAutocomplete.astro';
import games from '../data/games.json' with { type: 'json' };
import categories from '../data/categories.json' with { type: 'json' };

const playableGames = games.filter(g => !g.slug.includes('steam-key'));

// Platform detection helpers
function getPlatform(iframeUrl) {
  if (!iframeUrl) return 'gp';
  if (iframeUrl.includes('gamedistribution.com')) return 'gd';
  if (iframeUrl.includes('gamemonetize.co')) return 'gm';
  return 'gp';
}
function isPreferred(g) {
  const p = getPlatform(g.iframeUrl);
  return p === 'gd' || p === 'gm';
}

const featured = playableGames.filter(g => g.featured && isPreferred(g)).slice(0, 80);
// Fisher-Yates shuffle 随机打乱精选游戏
for (let i = featured.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [featured[i], featured[j]] = [featured[j], featured[i]];
}
// Daily seeded: 从高热度游戏池中取8款，每天不同
// 热度分 = score + featured加分 + playCount加分
const popularPool = playableGames
  .filter(isPreferred)
  .map(g => {
    let pop = g.score || 0;
    if (g.featured) pop += 5;
    if (g.playCount) pop += Math.min(Math.log10(g.playCount) * 3, 10);
    return { ...g, popularity: pop };
  })
  .sort((a, b) => b.popularity - a.popularity)
  .slice(0, 200);
const todaySeed = new Date().toISOString().slice(0, 10).split('').reduce((a, c) => a + c.charCodeAt(0), 0);
let sd = todaySeed;
for (let i = popularPool.length - 1; i > 0; i--) {
  sd = (sd * 16807) % 2147483647;
  const j = sd % (i + 1);
  [popularPool[i], popularPool[j]] = [popularPool[j], popularPool[i]];
}
const heroGames = popularPool.slice(0, 8);
// 每个分类取 2~3 款游戏，凑齐 48 款后随机打乱
const preferredGames = playableGames.filter(isPreferred);
const gamesByCategory = {};
for (const g of preferredGames) {
  const cat = g.category;
  if (!gamesByCategory[cat]) gamesByCategory[cat] = [];
  gamesByCategory[cat].push(g);
}
const catKeys = Object.keys(gamesByCategory);
// 每个分类至少取 2 款
const latestGames = catKeys.flatMap(key => {
  const group = gamesByCategory[key];
  const pick = [];
  for (let i = 0; i < 2 && group.length > 0; i++) {
    const idx = Math.floor(Math.random() * group.length);
    pick.push(group.splice(idx, 1)[0]);
  }
  return pick;
});
// 剩余 14 个名额分给随机 14 个分类，各加 1 款
const shuffled = catKeys.sort(() => Math.random() - 0.5);
for (let i = 0; i < 14 && i < shuffled.length; i++) {
  const group = gamesByCategory[shuffled[i]];
  if (group.length > 0) {
    const idx = Math.floor(Math.random() * group.length);
    latestGames.push(group.splice(idx, 1)[0]);
  }
}
// Fisher-Yates shuffle
for (let i = latestGames.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [latestGames[i], latestGames[j]] = [latestGames[j], latestGames[i]];
}
const categoryEntries = Object.entries(categories) as [string, { name: string; description: string; icon: string }][];
const emojiMap: Record<string, string> = {
  'match-3': '🍬', 'puzzle': '🧩', 'merge': '🧪', 'casual': '🎮', 'arcade': '👾',
  'word': '🔤', 'card': '🃏', 'hidden-object': '🔍', 'board': '♟️', 'strategy': '🎯',
  'adventure': '⚔️', 'sports': '⚽', 'racing': '🏎️', 'action': '🎯', 'fighting': '🥊',
  'multiplayer': '👥', 'idle': '📈',
};

// 预计算标签数据
const tagCN = {
  'action': '动作', 'adventure': '冒险', 'animals': '动物', 'arcade': '街机',
  'baseball': '棒球', 'basketball': '篮球', 'bike': '摩托', 'block': '方块',
  'board': '桌游', 'boat': '船', 'bubble': '泡泡', 'building': '建造',
  'car': '汽车', 'card': '纸牌', 'casual': '休闲', 'christmas': '圣诞',
  'city': '城市', 'coloring': '涂色', 'cooking': '烹饪', 'decorating': '装饰',
  'dress-up': '换装', 'driving': '驾驶', 'educational': '教育', 'endless': '无尽',
  'fantasy': '幻想', 'farming': '农场', 'fighting': '格斗', 'flying': '飞行',
  'football': '足球', 'golf': '高尔夫', 'halloween': '万圣节', 'hidden-object': '寻物',
  'idle': '挂机', 'io': 'IO', 'jump': '跳跃', 'magic': '魔法', 'match-3': '三消',
  'math': '数学', 'memory': '记忆', 'merge': '合成', 'multiplayer': '多人',
  'music': '音乐', 'ocean': '海洋', 'physics': '物理', 'puzzle': '益智',
  'racing': '竞速', 'shooting': '射击', 'simulation': '模拟', 'snow': '雪地',
  'space': '太空', 'sports': '体育', 'strategy': '策略', 'summer': '夏日',
  'survival': '生存', 'tennis': '网球', 'word': '文字', 'zombie': '僵尸',
  'snooker': '斯诺克',
};
const tagCounts: Record<string, number> = {};
for (const g of playableGames) {
  if (g.tags) {
    for (const t of g.tags) {
      tagCounts[t] = (tagCounts[t] || 0) + 1;
    }
  }
}
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 24);
// Always include snooker tag
if (!topTags.some(t => t[0] === 'snooker')) {
  topTags.push(['snooker', tagCounts['snooker'] || 27]);
}

const catGradients: Record<string, string> = {
  'match-3': 'from-pink-100 to-rose-100 dark:from-pink-900/40 dark:to-rose-900/40',
  'puzzle': 'from-blue-100 to-indigo-100 dark:from-blue-900/40 dark:to-indigo-900/40',
  'merge': 'from-emerald-100 to-teal-100 dark:from-emerald-900/40 dark:to-teal-900/40',
  'casual': 'from-amber-50 to-orange-100 dark:from-amber-900/30 dark:to-orange-900/40',
  'arcade': 'from-purple-100 to-violet-100 dark:from-purple-900/40 dark:to-violet-900/40',
  'word': 'from-sky-100 to-cyan-100 dark:from-sky-900/40 dark:to-cyan-900/40',
  'card': 'from-red-100 to-orange-100 dark:from-red-900/40 dark:to-orange-900/40',
  'hidden-object': 'from-lime-100 to-green-100 dark:from-lime-900/40 dark:to-green-900/40',
  'board': 'from-yellow-100 to-amber-100 dark:from-yellow-900/40 dark:to-amber-900/40',
  'strategy': 'from-slate-200 to-zinc-200 dark:from-slate-700/60 dark:to-zinc-700/60',
  'adventure': 'from-orange-100 to-red-100 dark:from-orange-900/40 dark:to-red-900/40',
  'sports': 'from-teal-100 to-cyan-100 dark:from-teal-900/40 dark:to-cyan-900/40',
  'racing': 'from-blue-200 to-sky-200 dark:from-blue-800/50 dark:to-sky-800/50',
  'action': 'from-rose-100 to-pink-100 dark:from-rose-900/40 dark:to-pink-900/40',
  'fighting': 'from-red-200 to-orange-200 dark:from-red-800/50 dark:to-orange-800/50',
  'multiplayer': 'from-indigo-100 to-blue-100 dark:from-indigo-900/40 dark:to-blue-900/40',
  'idle': 'from-gray-100 to-slate-100 dark:from-gray-700/60 dark:to-slate-700/60',
};
// Image optimization helpers
function preloadSrc(img: string | undefined, size: number): string {
  if (!img) return '';
  return img.includes('img.gamepix.com')
    ? img + (img.includes('?') ? '&' : '?') + `w=${size}&h=${Math.round(size*0.75)}&fit=crop&auto=format&q=75`
    : img;
}
function optImg(img: string | undefined, size: number): string {
  if (!img) return '';
  if (img.includes('img.gamepix.com')) {
    const params = `?w=${size}&h=${Math.round(size*0.75)}&fit=crop&auto=format&q=75`;
    return img + (img.includes('?') ? '&' : params);
  }
  return img;
}
const heroThumbs = heroGames.map(g => optImg(g.image, 320));
const featuredFirst = featured.slice(0, 20);
