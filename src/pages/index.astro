---
import Layout from '../layouts/Layout.astro';
import SearchAutocomplete from '../components/SearchAutocomplete.astro';
import games from '../data/games.json' with { type: 'json' };
import categories from '../data/categories.json' with { type: 'json' };

const playableGames = games.filter(g => !g.slug.includes('steam-key'));
const featured = playableGames.filter(g => g.featured).slice(0, 80);
// Fisher-Yates shuffle 随机打乱精选游戏
for (let i = featured.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [featured[i], featured[j]] = [featured[j], featured[i]];
}
const latestGames = playableGames.slice(-48).reverse();
const categoryEntries = Object.entries(categories) as [string, { name: string; description: string; icon: string }][];
const emojiMap: Record<string, string> = {
  'match-3': '🍬', 'puzzle': '🧩', 'merge': '🧪', 'casual': '🎮', 'arcade': '👾',
  'word': '🔤', 'card': '🃏', 'hidden-object': '🔍', 'board': '♟️', 'strategy': '🎯',
  'adventure': '⚔️', 'sports': '⚽', 'racing': '🏎️', 'action': '🎯', 'fighting': '🥊',
  'multiplayer': '👥', 'idle': '📈',
};

const catGradients: Record<string, string> = {
  'match-3': 'from-pink-100 to-rose-100 dark:from-pink-900/40 dark:to-rose-900/40',
  'puzzle': 'from-blue-100 to-indigo-100 dark:from-blue-900/40 dark:to-indigo-900/40',
  'merge': 'from-emerald-100 to-teal-100 dark:from-emerald-900/40 dark:to-teal-900/40',
  'casual': 'from-amber-50 to-orange-100 dark:from-amber-900/30 dark:to-orange-900/40',
  'arcade': 'from-purple-100 to-violet-100 dark:from-purple-900/40 dark:to-violet-900/40',
  'word': 'from-sky-100 to-cyan-100 dark:from-sky-900/40 dark:to-cyan-900/40',
  'card': 'from-red-100 to-orange-100 dark:from-red-900/40 dark:to-orange-900/40',
  'hidden-object': 'from-lime-100 to-green-100 dark:from-lime-900/40 dark:to-green-900/40',
  'board': 'from-yellow-100 to-amber-100 dark:from-yellow-900/40 dark:to-amber-900/40',
  'strategy': 'from-slate-200 to-zinc-200 dark:from-slate-700/60 dark:to-zinc-700/60',
  'adventure': 'from-orange-100 to-red-100 dark:from-orange-900/40 dark:to-red-900/40',
  'sports': 'from-teal-100 to-cyan-100 dark:from-teal-900/40 dark:to-cyan-900/40',
  'racing': 'from-blue-200 to-sky-200 dark:from-blue-800/50 dark:to-sky-800/50',
  'action': 'from-rose-100 to-pink-100 dark:from-rose-900/40 dark:to-pink-900/40',
  'fighting': 'from-red-200 to-orange-200 dark:from-red-800/50 dark:to-orange-800/50',
  'multiplayer': 'from-indigo-100 to-blue-100 dark:from-indigo-900/40 dark:to-blue-900/40',
  'idle': 'from-gray-100 to-slate-100 dark:from-gray-700/60 dark:to-slate-700/60',
};
---

<Layout title="Free Relaxing Browser Games - Play Online Instantly">
  <!-- Notification bar -->
  <div id="notif-bar" class="relative overflow-hidden h-12 bg-gradient-to-r from-orange-500 to-pink-500 dark:from-orange-600 dark:to-pink-600 text-white text-base font-bold shadow-md flex items-center" style="cursor:default">
    <div id="notif-text" class="whitespace-nowrap will-change-transform" style="animation: marquee 18s linear forwards">
      🎮 <span class="game-count">{games.length}</span> <span data-i18n="notif.text">free games and counting — new ones added regularly!</span> 🎮
    </div>
  </div>
  <style is:global>
    @keyframes marquee {
      from { transform: translateX(100vw); }
      to { transform: translateX(-100%); }
    }
  </style>
  <script>
    document.getElementById('notif-text')?.addEventListener('animationend', () => {
      const bar = document.getElementById('notif-bar');
      if (bar) {
        bar.style.transition = 'opacity 0.5s, height 0.5s, margin 0.5s';
        bar.style.opacity = '0';
        bar.style.height = '0';
        bar.style.margin = '0';
        bar.style.padding = '0';
        bar.style.overflow = 'hidden';
        setTimeout(() => { if (bar.parentNode) bar.parentNode.removeChild(bar); }, 600);
      }
    });
  </script>

  <style is:global>
    .gc {
      display: block;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      transition: box-shadow .3s, border-color .3s, transform .3s;
      text-decoration: none;
    }
    .dark .gc {
      background: #1e293b;
      border-color: #334155;
    }
    .gc:hover {
      transform: translateY(-3px);
      border-color: #a78bfa;
      box-shadow: 0 0 0 2px #a78bfa, 0 8px 25px rgba(129,140,248,.3);
    }
    .dark .gc:hover {
      box-shadow: 0 0 0 2px #a78bfa, 0 8px 25px rgba(129,140,248,.15);
    }
    .gc-thumb {
      position: relative;
      aspect-ratio: 4/3;
      background: linear-gradient(135deg, #e0e7ff, #e9d5ff);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dark .gc-thumb {
      background: linear-gradient(135deg, #312e81, #4c1d95);
    }
    .gc-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      will-change: transform;
      transition: transform .35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .gc:hover .gc-thumb img {
      transform: scale(1.45);
    }
    .gc-thumb .gc-icon {
      font-size: 2.5rem;
    }
    .gc-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s;
    }
    .gc:hover .gc-overlay {
      background: rgba(0,0,0,.12);
    }
    .gc-play {
      width: 44px;
      height: 44px;
      background: rgba(255,255,255,.95);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.8);
      transition: all .22s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 14px rgba(0,0,0,.2);
      cursor: pointer;
    }
    .gc:hover .gc-play {
      opacity: 1;
      transform: scale(1);
      animation: gc-pulse 1.2s ease-in-out infinite;
    }
    .gc-play svg {
      width: 22px;
      height: 22px;
      color: #4f46e5;
      margin-left: 3px;
    }
    .gc:hover .gc-play svg {
      color: #7c3aed;
    }
    .gc-title {
      display: block;
      padding: 6px 8px;
      font-size: .75rem;
      line-height: 1.2;
      color: #334155;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color .25s;
    }
    .dark .gc-title {
      color: #e2e8f0;
    }
    .gc:hover .gc-title {
      color: #7c3aed;
    }
    .dark .gc:hover .gc-title {
      color: #a78bfa;
    }

    @keyframes gc-pulse {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(129,140,248,.4); }
      50% { transform: scale(1.1); box-shadow: 0 0 0 14px rgba(129,140,248,0); }
    }

    /* Entrance animation */
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(24px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .gc, .cat-card {
      opacity: 0;
    }
    .gc.visible, .cat-card.visible {
      animation: fade-up .4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    /* Category card animations */
    .cat-card {
      transition: all .25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .cat-card:hover {
      transform: translateY(-4px) scale(1.03);
    }
  </style>

  <!-- Hero -->
  <section class="relative text-center py-6 md:py-10 overflow-hidden bg-slate-50 dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm mb-8">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-24 -left-24 w-64 h-64 bg-indigo-200 dark:bg-indigo-800/40 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-purple-200 dark:bg-purple-800/40 rounded-full blur-3xl"></div>
    </div>
    <div class="relative px-6 py-4 md:px-10 md:py-6 max-w-2xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-800 dark:text-slate-100 mb-2">
        Chill Arcade
        <span class="block text-indigo-600 dark:text-indigo-400 text-xl md:text-2xl mt-1">{games.length} <span data-i18n="hero.count">Free Browser Games</span></span>
      </h1>
      <p class="text-sm md:text-base text-slate-500 dark:text-slate-400 max-w-xl mx-auto mb-3" data-i18n="hero.subtitle">
        No downloads, no sign-ups, no paywalls. Click and play thousands of games across multiple categories, supporting 16 languages. From match-3 puzzles to strategy adventures, from sports racing to fighting battles, from casual games to card games and more — all the entertainment you're looking for is right here. New games are added continuously. Play on mobile, desktop, tablet, and other devices.
      </p>
      <div class="flex flex-wrap justify-center gap-2.5">
        <a href="#categories" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 dark:shadow-indigo-900/30 transition-all hover:scale-105 text-sm" data-i18n="hero.browse">
          Browse by Category
        </a>
        <a href="/games" class="px-6 py-2 bg-white dark:bg-slate-700 text-indigo-600 dark:text-indigo-400 font-semibold rounded-xl border border-slate-200 dark:border-slate-600 shadow-sm hover:shadow-md hover:scale-105 transition-all text-sm">
          🎮 <span data-i18n="view_all">View All Games</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Search & Filter -->
  <section class="mb-6">
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
      <div class="flex flex-col sm:flex-row gap-2">
        <SearchAutocomplete />
        <select id="category-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          <option value="" data-i18n="filter.all">All Categories</option>
          {categoryEntries.map(([slug, cat]) => (
            <option value={slug} data-i18n={`cat.${slug}`}>{cat.name}</option>
          ))}
        </select>
        <select id="difficulty-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          <option value="" data-i18n="filter.all">All Difficulties</option>
          <option value="easy" data-i18n="filter.easy">Easy</option>
          <option value="medium" data-i18n="filter.medium">Medium</option>
          <option value="hard" data-i18n="filter.hard">Hard</option>
        </select>
      </div>
      <div id="search-results-info" class="mt-1 text-xs text-slate-400 hidden">
        <span id="result-count">0</span> <span data-i18n="search.found">games found</span>
        <span class="mx-1">·</span>
        <a href="/games" class="text-indigo-500 hover:text-indigo-600 underline">View all games</a>
      </div>
    </div>
    <!-- Tag filter -->
    <div id="tag-filter" class="flex flex-wrap gap-1.5 mt-2"></div>
  </section>

  <!-- Dynamic search results -->
  <div id="search-results" class="hidden mb-8">
    <div id="results-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-2"></div>
  </div>

  <!-- Featured Games -->
  <section id="featured" class="mb-10">
    <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-3">🔥 <span data-i18n="section.featured">Featured Games</span></h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 2xl:grid-cols-10 gap-3">
      {featured.map(game => (
        <a href={`/games/${game.slug}`} class="gc">
          <div class="gc-thumb">
            {game.image
              ? <img src={game.image} alt={game.title} loading="eager" decoding="async" width="320" height="240" onerror="this.style.display='none'" />
              : <span class="gc-icon">{emojiMap[game.category] || '🎮'}</span>
            }
            <div class="gc-overlay">
              <div class="gc-play">
                <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <span class="gc-title">{game.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Games -->
  <section id="latest" class="mb-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">🆕 <span data-i18n="section.latest">Latest Games</span></h2>
      <a href="/games" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors inline-flex items-center gap-1">
        View all <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 2xl:grid-cols-10 gap-2">
      {latestGames.map(game => (
        <a href={`/games/${game.slug}`} class="gc">
          <div class="gc-thumb">
            {game.image
              ? <img src={game.image} alt={game.title} loading="lazy" decoding="async" width="240" height="180" onerror="this.style.display='none'" />
              : <span class="gc-icon">{emojiMap[game.category] || '🎮'}</span>
            }
            <div class="gc-overlay">
              <div class="gc-play">
                <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <span class="gc-title">{game.title}</span>
        </a>
      ))}
    </div>
    <div class="mt-6 text-center">
      <a href="/games" class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 dark:shadow-indigo-900/30 transition-all hover:scale-105 text-sm">
        🎮 <span data-i18n="view_all_count" data-i18n-count={games.length}>View All {games.length} Games</span>
      </a>
    </div>
  </section>

  <!-- Categories -->
  <section id="categories" class="mb-10">
    <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-4">📂 <span data-i18n="nav.categories">Browse by Category</span></h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 2xl:grid-cols-10 gap-2">
      {categoryEntries.map(([slug, cat]) => {
        const count = games.filter(g => g.category === slug).length;
        const gradient = catGradients[slug] || 'from-slate-100 to-gray-100 dark:from-slate-700/60 dark:to-gray-700/60';
        return (
          <a href={`/category/${slug}`} class="cat-card block bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-600 shadow-sm hover:shadow-md overflow-hidden">
            <div class={`bg-gradient-to-br ${gradient} p-4 flex items-center justify-center text-4xl`}>
              {cat.icon}
            </div>
            <div class="p-2 text-center">
              <div class="text-base font-semibold text-slate-700 dark:text-slate-200 truncate"><span data-i18n={`cat.${slug}`}>{cat.name}</span></div>
              <div class="text-sm text-slate-400 mt-0.5">{count} <span data-i18n="cat.games">games</span></div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Schema structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Chill Arcade",
    "url": "https://chillarcade.io",
    "description": "Play free relaxing online games in your browser. No download, no signup, instant fun!",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://chillarcade.io/games/{search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- Game search data (cached in localStorage) -->
  <script is:inline>
    (function(){
      var data = null;
      // Try immediate cache restore
      try { var c = JSON.parse(localStorage.getItem('sd')); if (c && c.d) { data = c.d; window.__gamesData = c.d; } } catch(e){}
      if (data) window.__gamesDataPromise = Promise.resolve(data);
      // Background version check + update
      var p = fetch('/search-data-version.json?' + Date.now()).then(function(r){ return r.json(); }).then(function(v){
        if (localStorage.getItem('sdv') === v.hash && data) return data;
        return fetch('/search-data.json').then(function(r){ return r.json(); }).then(function(d){
          window.__gamesData = d;
          try { localStorage.setItem('sd', JSON.stringify({d:d})); localStorage.setItem('sdv', v.hash); } catch(e){}
          return d;
        });
      }).catch(function(){
        if (!window.__gamesData) window.__gamesData = [];
        return window.__gamesData;
      });
      if (!window.__gamesDataPromise) window.__gamesDataPromise = p;
    })();
  </script>
</Layout>

<script>
  const searchInput = document.getElementById('search-input');
  const categoryFilter = document.getElementById('category-filter');
  const difficultyFilter = document.getElementById('difficulty-filter');
  const tagFilter = document.getElementById('tag-filter');
  const resultsInfo = document.getElementById('search-results-info');
  const resultCount = document.getElementById('result-count');
  const searchResults = document.getElementById('search-results');
  const resultsGrid = document.getElementById('results-grid');

  // Hide sections when search is active
  const categoriesSection = document.getElementById('categories');
  const featuredSection = document.getElementById('featured');
  const latestSection = document.getElementById('latest');

  let selectedTag = '';
  let allGamesData = window.__gamesData || [];

  // When search data finishes loading, build tag filter and re-run any active filter
  (window.__gamesDataPromise || Promise.resolve([])).then(function(data) {
    allGamesData = data;
    buildTagFilter();
    if (searchInput?.value || categoryFilter?.value || difficultyFilter?.value || selectedTag) {
      filterGames();
    }
  });

  function buildTagFilter() {
    if (!tagFilter || !allGamesData.length) return;
    const tagCN = {
      'action': '动作', 'adventure': '冒险', 'animals': '动物', 'arcade': '街机',
      'baseball': '棒球', 'basketball': '篮球', 'bike': '摩托', 'block': '方块',
      'board': '桌游', 'boat': '船', 'bubble': '泡泡', 'building': '建造',
      'car': '汽车', 'card': '纸牌', 'casual': '休闲', 'christmas': '圣诞',
      'city': '城市', 'coloring': '涂色', 'cooking': '烹饪', 'decorating': '装饰',
      'dress-up': '换装', 'driving': '驾驶', 'educational': '教育', 'endless': '无尽',
      'fantasy': '幻想', 'farming': '农场', 'fighting': '格斗', 'flying': '飞行',
      'football': '足球', 'golf': '高尔夫', 'halloween': '万圣节', 'hidden-object': '寻物',
      'idle': '挂机', 'io': 'IO', 'jump': '跳跃', 'magic': '魔法', 'match-3': '三消',
      'math': '数学', 'memory': '记忆', 'merge': '合成', 'multiplayer': '多人',
      'music': '音乐', 'ocean': '海洋', 'physics': '物理', 'puzzle': '益智',
      'racing': '竞速', 'shooting': '射击', 'simulation': '模拟', 'snow': '雪地',
      'space': '太空', 'sports': '体育', 'strategy': '策略', 'summer': '夏日',
      'survival': '生存', 'tennis': '网球', 'word': '文字', 'zombie': '僵尸',
    };
    const lang = localStorage.getItem('i18n_lang') || 'en';
    const counts = {};
    allGamesData.forEach(g => {
      if (g.tags) g.tags.forEach(t => { counts[t] = (counts[t] || 0) + 1; });
    });
    const sorted = Object.entries(counts).sort((a,b) => b[1] - a[1]).slice(0, 24);
    tagFilter.innerHTML = sorted.map(([tag, count]) => {
      const label = lang === 'zh' || lang === 'zh-tw' ? (tagCN[tag] || tag) : tag;
      return `<button data-tag="${tag}" class="tag-chip px-2.5 py-1 text-xs font-medium rounded-full border border-slate-200 dark:border-slate-600 text-slate-500 dark:text-slate-400 hover:border-indigo-300 dark:hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all whitespace-nowrap">${label} (${count})</button>`;
    }).join('');
    tagFilter.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-tag]');
      if (!btn) return;
      const tag = btn.getAttribute('data-tag');
      if (selectedTag === tag) {
        selectedTag = '';
        btn.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
        btn.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
      } else {
        tagFilter.querySelectorAll('[data-tag]').forEach(b => {
          b.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
          b.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
        });
        selectedTag = tag;
        btn.classList.remove('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
        btn.classList.add('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
      }
      filterGames();
    });
  }

  function renderResults(games) {
    if (!resultsGrid || !searchResults) return;
    if (games.length === 0) {
      resultsGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg mb-1">🔍</p><p data-i18n="search.noresults">No games found. Try a different search.</p></div>';
      return;
    }
    const emojiMap = {'match-3':'🍬','puzzle':'🧩','merge':'🧪','casual':'🎮','arcade':'👾','word':'🔤','card':'🃏','hidden-object':'🔍','board':'♟️','strategy':'🎯','adventure':'⚔️','sports':'⚽','racing':'🏎️','action':'🎯','fighting':'🥊','multiplayer':'👥','idle':'📈'};
    resultsGrid.innerHTML = games.map(g => `
      <a href="/games/${g.slug}" class="gc">
        <div class="gc-thumb">
          ${g.image
            ? `<img src="${g.image}" alt="${g.title}" loading="lazy" decoding="async" width="240" height="180" />`
            : `<span class="gc-icon">${emojiMap[g.category] || '🎮'}</span>`
          }
          <div class="gc-overlay">
            <div class="gc-play">
              <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <span class="gc-title">${g.title}</span>
      </a>
    `).join('');
    // Animate new cards
    resultsGrid.querySelectorAll('.gc').forEach(function(el) {
      if (!el.classList.contains('visible')) el.classList.add('visible');
    });
  }

  function filterGames() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    const category = categoryFilter?.value || '';
    const difficulty = difficultyFilter?.value || '';
    const isActive = query || category || difficulty || selectedTag;

    const filtered = allGamesData.filter(g => {
      const matchCategory = !category || g.category === category;
      const matchDifficulty = !difficulty || g.difficulty === difficulty;
      const matchTag = !selectedTag || (g.tags && g.tags.includes(selectedTag));
      const matchSearch = !query ||
        g.title.toLowerCase().includes(query) ||
        g.description.toLowerCase().includes(query) ||
        g.category.includes(query) ||
        (g.tags && g.tags.some(t => t.includes(query)));
      return matchCategory && matchDifficulty && matchTag && matchSearch;
    });

    // Show/hide results info
    if (resultsInfo && resultCount) {
      if (isActive) {
        resultsInfo.classList.remove('hidden');
        resultCount.textContent = filtered.length;
      } else {
        resultsInfo.classList.add('hidden');
      }
    }

    // Show/hide sections and render results
    if (isActive && searchResults && resultsGrid) {
      searchResults.classList.remove('hidden');
      if (categoriesSection) categoriesSection.style.display = 'none';
      if (featuredSection) featuredSection.style.display = 'none';
      if (latestSection) latestSection.style.display = 'none';
      renderResults(filtered);
    } else {
      if (searchResults) searchResults.classList.add('hidden');
      if (categoriesSection) categoriesSection.style.display = '';
      if (featuredSection) featuredSection.style.display = '';
      if (latestSection) latestSection.style.display = '';
    }
  }

  searchInput?.addEventListener('input', filterGames);
  categoryFilter?.addEventListener('change', filterGames);
  difficultyFilter?.addEventListener('change', filterGames);

  document.addEventListener('i18nchange', buildTagFilter);

  // Scroll entrance animation
  function observeCards() {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px 80px 0px', threshold: 0.1 });
    document.querySelectorAll('.gc, .cat-card').forEach(function(el) {
      observer.observe(el);
    });
  }
  // Run after search data loads to also cover dynamically rendered cards
  (window.__gamesDataPromise || Promise.resolve([])).then(observeCards);
  observeCards();
</script>
