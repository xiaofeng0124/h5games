---
import Layout from '../layouts/Layout.astro';
import games from '../data/games.json' with { type: 'json' };
import categories from '../data/categories.json' with { type: 'json' };

const featured = games.filter(g => g.featured).slice(0, 6);
const featuredSlugs = new Set(featured.map(g => g.slug));
const allGames = games.filter(g => !featuredSlugs.has(g.slug));
const categoryEntries = Object.entries(categories) as [string, { name: string; description: string; icon: string }][];
const emojiMap: Record<string, string> = {
  'match-3': '💎', 'puzzle': '🧩', 'merge': '🔄', 'casual': '🎮', 'arcade': '🕹️', 'word': '📝', 'card': '🃏', 'hidden-object': '🔍', 'board': '♟️', 'strategy': '🧠', 'adventure': '⚔️', 'sports': '🏆', 'racing': '🏎️', 'action': '🎯', 'fighting': '🥊', 'multiplayer': '🌐', 'idle': '⏳',
};
---

<Layout title="Free Relaxing Browser Games - Play Online Instantly">
  <!-- Notification bar -->
  <div id="notif-bar" class="relative overflow-hidden h-12 bg-gradient-to-r from-orange-500 to-pink-500 dark:from-orange-600 dark:to-pink-600 text-white text-base font-bold shadow-md flex items-center" style="cursor:default">
    <div id="notif-text" class="whitespace-nowrap will-change-transform" style="animation: marquee 18s linear forwards">
      🎮 <span class="game-count">{games.length}</span> <span data-i18n="notif.text">free games and counting — new ones added regularly!</span> 🎮
    </div>
  </div>
  <style is:global>
    @keyframes marquee {
      from { transform: translateX(100vw); }
      to { transform: translateX(-100%); }
    }
  </style>
  <script>
    document.getElementById('notif-text')?.addEventListener('animationend', () => {
      const bar = document.getElementById('notif-bar');
      if (bar) {
        bar.style.transition = 'opacity 0.5s, height 0.5s, margin 0.5s';
        bar.style.opacity = '0';
        bar.style.height = '0';
        bar.style.margin = '0';
        bar.style.padding = '0';
        bar.style.overflow = 'hidden';
        setTimeout(() => { if (bar.parentNode) bar.parentNode.removeChild(bar); }, 600);
      }
    });
  </script>

  <style is:global>
    .gc {
      display: block;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      transition: box-shadow .3s, border-color .3s, transform .3s;
      text-decoration: none;
    }
    .dark .gc {
      background: #1e293b;
      border-color: #334155;
    }
    .gc:hover {
      transform: translateY(-3px);
      border-color: #a78bfa;
      box-shadow: 0 0 0 2px #a78bfa, 0 8px 25px rgba(129,140,248,.3);
    }
    .dark .gc:hover {
      box-shadow: 0 0 0 2px #a78bfa, 0 8px 25px rgba(129,140,248,.15);
    }
    .gc-thumb {
      position: relative;
      aspect-ratio: 4/3;
      background: linear-gradient(135deg, #e0e7ff, #e9d5ff);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dark .gc-thumb {
      background: linear-gradient(135deg, #312e81, #4c1d95);
    }
    .gc-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      will-change: transform;
      transition: transform .35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .gc:hover .gc-thumb img {
      transform: scale(1.28);
    }
    .gc-thumb .gc-icon {
      font-size: 2.5rem;
    }
    .gc-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s;
    }
    .gc:hover .gc-overlay {
      background: rgba(0,0,0,.12);
    }
    .gc-play {
      width: 44px;
      height: 44px;
      background: rgba(255,255,255,.95);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.8);
      transition: all .22s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 14px rgba(0,0,0,.2);
    }
    .gc:hover .gc-play {
      opacity: 1;
      transform: scale(1);
      animation: gc-pulse 1.2s ease-in-out infinite;
    }
    .gc-play svg {
      width: 22px;
      height: 22px;
      color: #4f46e5;
      margin-left: 3px;
    }
    .gc:hover .gc-play svg {
      color: #7c3aed;
    }
    .gc-title {
      display: block;
      padding: 6px 8px;
      font-size: .75rem;
      line-height: 1.2;
      color: #334155;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color .25s;
    }
    .dark .gc-title {
      color: #e2e8f0;
    }
    .gc:hover .gc-title {
      color: #7c3aed;
    }
    .dark .gc:hover .gc-title {
      color: #a78bfa;
    }

    @keyframes gc-pulse {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(129,140,248,.4); }
      50% { transform: scale(1.1); box-shadow: 0 0 0 14px rgba(129,140,248,0); }
    }
  </style>

  <!-- Hero -->
  <section class="relative text-center py-8 md:py-16 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-24 -left-24 w-64 h-64 bg-indigo-200/30 dark:bg-indigo-800/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-purple-200/30 dark:bg-purple-800/20 rounded-full blur-3xl"></div>
    </div>
    <h1 class="relative text-3xl md:text-5xl font-extrabold text-slate-800 dark:text-slate-100 mb-2">
      Chill Arcade
      <span class="block text-indigo-600 dark:text-indigo-400 text-xl md:text-2xl mt-1">{games.length} Free Browser Games</span>
    </h1>
    <p class="relative text-sm md:text-base text-slate-500 dark:text-slate-400 max-w-xl mx-auto mb-4" data-i18n="hero.subtitle">
      No downloads. No signups. Just click and play.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="#categories" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 dark:shadow-indigo-900/30 transition-all hover:scale-105 text-sm" data-i18n="hero.browse">
        Browse by Category
      </a>
    </div>
  </section>

  <!-- Search & Filter -->
  <section class="mb-6">
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
      <div class="flex flex-col sm:flex-row gap-2">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="search-input" data-i18n="search.placeholder" data-i18n-attr="placeholder" placeholder="Search {games.length} games..." class="w-full pl-9 pr-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent" />
        </div>
        <select id="category-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          <option value="" data-i18n="filter.all">All Categories</option>
          {categoryEntries.map(([slug, cat]) => (
            <option value={slug}>{cat.name}</option>
          ))}
        </select>
        <select id="difficulty-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          <option value="" data-i18n="filter.all">All Difficulties</option>
          <option value="easy" data-i18n="filter.easy">Easy</option>
          <option value="medium" data-i18n="filter.medium">Medium</option>
          <option value="hard" data-i18n="filter.hard">Hard</option>
        </select>
      </div>
      <div id="search-results-info" class="mt-1 text-xs text-slate-400 hidden">
        <span id="result-count">0</span> <span data-i18n="search.found">games found</span>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section id="categories" class="mb-8" style="content-visibility:auto">
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-9 gap-2">
      {categoryEntries.map(([slug, cat]) => {
        const count = games.filter(g => g.category === slug).length;
        return (
          <a href={`/category/${slug}`} class="flex items-center gap-2 p-2.5 bg-white dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-600 hover:shadow-sm transition-all group">
            <span class="text-lg shrink-0">{cat.icon}</span>
            <div class="min-w-0">
              <div class="text-xs font-medium text-slate-700 dark:text-slate-300 truncate"><span data-i18n={`cat.${slug}`}>{cat.name}</span></div>
              <div class="text-[10px] text-slate-400">{count} <span data-i18n="cat.games">games</span></div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Featured Games -->
  <section class="mb-8">
    <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-3">🔥 <span data-i18n="section.featured">Featured Games</span></h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {featured.map(game => (
        <a href={`/games/${game.slug}`} class="gc"
          data-category={game.category}
          data-title={game.title.toLowerCase()}
          data-description={game.shortDescription.toLowerCase()}
          data-difficulty={game.difficulty || ''}>
          <div class="gc-thumb">
            {game.image
              ? <img src={game.image} alt={game.title} loading="eager" decoding="async" />
              : <span class="gc-icon">{emojiMap[game.category] || '🎮'}</span>
            }
            <div class="gc-preview" data-preview-src={game.iframeUrl ? game.iframeUrl.split('?')[0] : ''}></div>
            <div class="gc-overlay">
              <div class="gc-play">
                <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <span class="gc-title">{game.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- All Games -->
  <section class="mb-8" style="content-visibility:auto">
    <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100 mb-3">🎮 <span data-i18n="section.latest">All Games</span> ({allGames.length})</h2>
    <div id="all-games-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-7 gap-2">
      {allGames.map(game => (
        <a href={`/games/${game.slug}`} class="gc"
          data-category={game.category}
          data-title={game.title.toLowerCase()}
          data-description={game.shortDescription.toLowerCase()}
          data-difficulty={game.difficulty || ''}>
          <div class="gc-thumb">
            {game.image
              ? <img src={game.image} alt={game.title} loading="lazy" decoding="async" />
              : <span class="gc-icon">{emojiMap[game.category] || '🎮'}</span>
            }
            <div class="gc-preview" data-preview-src={game.iframeUrl ? game.iframeUrl.split('?')[0] : ''}></div>
              <div class="gc-play">
                <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <span class="gc-title">{game.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Schema structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Chill Arcade",
    "url": "https://chillarcade.io",
    "description": "Play free relaxing online games in your browser. No download, no signup, instant fun!",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://chillarcade.io/games/{search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
</Layout>

<script>
  const searchInput = document.getElementById('search-input');
  const categoryFilter = document.getElementById('category-filter');
  const difficultyFilter = document.getElementById('difficulty-filter');
  const resultsInfo = document.getElementById('search-results-info');
  const resultCount = document.getElementById('result-count');
  const gameCards = document.querySelectorAll('[data-category]');

  function filterGames() {
    const query = searchInput.value.trim().toLowerCase();
    const category = categoryFilter.value;
    const difficulty = difficultyFilter.value;
    let visibleCount = 0;

    gameCards.forEach(card => {
      const matchCategory = !category || card.dataset.category === category;
      const matchDifficulty = !difficulty || card.dataset.difficulty === difficulty;
      const matchSearch = !query ||
        card.dataset.title.includes(query) ||
        card.dataset.description.includes(query) ||
        card.dataset.category.includes(query);

      if (matchCategory && matchDifficulty && matchSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (query || category || difficulty) {
      resultsInfo.classList.remove('hidden');
      resultCount.textContent = visibleCount;
    } else {
      resultsInfo.classList.add('hidden');
    }
  }

  searchInput.addEventListener('input', filterGames);
  categoryFilter.addEventListener('change', filterGames);
  difficultyFilter.addEventListener('change', filterGames);
</script>
