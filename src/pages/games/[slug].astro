---
import Layout from '../../layouts/Layout.astro';
import GameGrid from '../../components/GameGrid.astro';
import type { Game } from '../../data/games';
import gamesData from '../../data/games.json' with { type: 'json' };

export async function getStaticPaths() {
  return (gamesData as Game[]).map((game: Game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const allGames = gamesData as Game[];

// Related games from same category
const related = allGames
  .filter((g: Game) => g.category === game.category && g.slug !== game.slug)
  .slice(0, 8);

const canonicalUrl = `https://chillarcade.io/games/${game.slug}`;
---

<Layout title={game.title} description={game.shortDescription} image={game.image} canonical={canonicalUrl}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-4">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <a href={`/category/${game.category}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors capitalize"><span data-i18n={`cat.${game.category}`}>{game.category}</span></a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300">{game.title}</span>
  </nav>

  <!-- Game Header -->
  <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-8">
    <div class="p-6 pb-0">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100">{game.title}</h1>
          <div class="flex items-center gap-3 mt-2">
            <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-3 py-1 rounded-full capitalize"><span data-i18n={`cat.${game.category}`}>{game.category}</span></span>
            <span class="text-sm text-slate-400">⭐ {game.rating || 4.0}</span>
            {game.playCount ? <span class="text-sm text-slate-400">👥 {game.playCount.toLocaleString()} plays</span> : null}
          </div>
        </div>
        <button id="fav-btn" data-slug={game.slug} data-title={game.title} data-category={game.category}
          class="flex items-center gap-1.5 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-600 text-sm font-medium transition-all hover:scale-105"
          aria-label="Add to favorites">
          <span id="fav-icon" class="text-lg">🤍</span>
          <span id="fav-label" data-i18n="game.save">Save</span>
        </button>
      </div>
    </div>

    <!-- Game iframe area with click-to-play -->
    <div id="game-container" class="w-full bg-slate-900 relative overflow-hidden">
      <!-- Fullscreen toggle (visible on mobile after game starts) -->
      <button id="fs-btn" aria-label="Toggle fullscreen"
        class="absolute top-3 right-3 z-40 w-9 h-9 hidden items-center justify-center rounded-lg bg-black/40 text-white/80 hover:bg-black/60 transition-colors backdrop-blur-sm">
        <svg id="fs-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="fs-enter" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"/>
        </svg>
      </button>
      <div class="w-full max-w-4xl mx-auto aspect-[4/3] md:aspect-[16/9] relative">
        <!-- Cover image + play button overlay -->
        <div id="game-cover" class="absolute inset-0 z-10 flex flex-col items-center justify-center cursor-pointer rounded-none" style="background:linear-gradient(135deg,#1e1b4b,#312e81)">
          {game.image && (
            <img src={game.image} alt={game.title} class="absolute inset-0 w-full h-full object-cover opacity-40" fetchpriority="high" onerror="this.style.display='none'" />
          )}
          <div class="relative flex flex-col items-center gap-4">
            <div id="play-btn" class="w-20 h-20 rounded-full bg-indigo-600/90 hover:bg-indigo-500 flex items-center justify-center transition-all hover:scale-110 shadow-2xl shadow-indigo-500/50">
              <svg class="w-10 h-10 text-white ml-1.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <span class="text-white/90 text-lg font-semibold drop-shadow-lg" data-i18n="game.click_play">Click to Play</span>
          </div>
        </div>
        <!-- Loading overlay with progress -->
        <div id="game-loading" class="absolute inset-0 z-20 hidden" style="background:linear-gradient(135deg,#1e1b4b,#312e81)">
          {game.image && (
            <img src={game.image} alt="" class="absolute inset-0 w-full h-full object-cover opacity-20 blur-sm" loading="lazy" aria-hidden="true" onerror="this.style.display='none'" />
          )}
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
            <!-- Spinner -->
            <div class="w-12 h-12 border-4 border-slate-600 border-t-indigo-500 rounded-full animate-spin"></div>
            <!-- Progress bar -->
            <div class="w-64 max-w-[80vw] bg-slate-700/60 rounded-full h-2.5 overflow-hidden backdrop-blur-sm">
              <div id="progress-bar" class="h-full w-0 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 transition-all duration-300 ease-out"></div>
            </div>
            <p id="progress-text" class="text-white/80 text-sm font-medium">0%</p>
            <p class="text-slate-400 text-xs" data-i18n="game.loading">Loading game...</p>
          </div>
        </div>
        {game.iframeUrl ? (
          <iframe id="game-iframe" data-src={game.iframeUrl} class="absolute inset-0 w-full h-full z-30 pointer-events-none" allow="autoplay *; fullscreen *" allowfullscreen sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms allow-pointer-lock allow-modals"></iframe>
        ) : (
          <div class="absolute inset-0 z-30 flex flex-col items-center justify-center text-center p-8">
            <div class="text-6xl mb-4">🎮</div>
            <p class="text-slate-300 text-lg font-medium" data-i18n="game.loading_title">Game Loading...</p>
            <p class="text-slate-400 text-sm mt-2" data-i18n="game.click_play">Click the button below to start playing</p>
            <button class="mt-4 px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-all hover:scale-105 shadow-lg" data-i18n="game.playnow">
              ▶ Play Now
            </button>
          </div>
        )}
      </div>
    </div>

    <!-- Game description and instructions -->
    <div class="p-6">
      <div class="prose prose-slate dark:prose-invert max-w-none">
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{game.description}</p>
      </div>

      {game.instructions && (
        <div class="mt-6">
          <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-3" data-i18n="game.howtoplay">📖 How to Play</h2>
          <p class="text-slate-600 dark:text-slate-300">{game.instructions}</p>
        </div>
      )}

      <div class="flex flex-wrap gap-2 mt-6">
        {game.tags?.map(tag => (
          <span class="text-xs bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 px-3 py-1 rounded-full">#{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Guide Section -->
  {game.guideTitle && game.guideContent && (
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-8 p-6">
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-4">📝 {game.guideTitle}</h2>
      <div class="text-slate-600 dark:text-slate-300 leading-relaxed space-y-3 [&_strong]:text-slate-800 dark:[&_strong]:text-slate-200 [&_p]:mb-3 last:[&_p]:mb-0" set:html={game.guideContent}>
      </div>
    </div>
  )}

  <!-- Related Games -->
  {related.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-6" data-i18n="game.related">🎯 You May Also Like</h2>
      <GameGrid games={related} cols={4} />
    </section>
  )}

  <style is:global>
    /* Fullscreen styles for game container — native Fullscreen API */
    #game-container:fullscreen, #game-container:-webkit-full-screen {
      width: 100vw; height: 100vh; max-width: 100%; background: #000;
    }
    #game-container:fullscreen .max-w-4xl,
    #game-container:-webkit-full-screen .max-w-4xl {
      max-width: 100%; height: 100%; aspect-ratio: auto;
    }
    /* CSS fallback fullscreen for iOS where Fullscreen API not supported on <div> */
    #game-container.fs-mode {
      position: fixed !important;
      inset: 0 !important;
      max-width: 100% !important;
      width: 100vw !important;
      width: 100dvw !important;
      height: 100dvh !important;
      z-index: 9999 !important;
      background: #000 !important;
    }
    #game-container.fs-mode .max-w-4xl {
      max-width: 100% !important;
      height: 100% !important;
      aspect-ratio: auto !important;
    }
  </style>

  <!-- Game Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": game.title,
    "description": game.shortDescription,
    "genre": game.category,
    "applicationCategory": "Game",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />
</Layout>

<script>
  const favBtnData = document.getElementById('fav-btn')?.dataset;
  const slug = favBtnData?.slug || '';
  const title = favBtnData?.title || '';
  const category = favBtnData?.category || '';
  let iframeLoaded = false;
  let progressTimer = null;

  // === Click-to-Play: load iframe on demand ===
  const gameCover = document.getElementById('game-cover');
  const gameIframe = document.getElementById('game-iframe');
  const gameLoading = document.getElementById('game-loading');
  const progressBar = document.getElementById('progress-bar');
  const progressText = document.getElementById('progress-text');

  // Simulated progress: fast start, decelerating curve
  function startProgressSimulation() {
    let p = 0;
    const steps = [
      { target: 15, duration: 400 },
      { target: 30, duration: 800 },
      { target: 50, duration: 1500 },
      { target: 70, duration: 3000 },
      { target: 82, duration: 4000 },
      { target: 90, duration: 6000 },
      { target: 94, duration: 10000 },
    ];
    let stepIdx = 0;
    let stepStart = performance.now();
    let stepStartP = 0;

    function tick(now) {
      if (!progressBar || !progressText) return;
      const step = steps[stepIdx];
      if (!step) {
        // Hold at ~94-96%
        p = Math.min(p + 0.3, 96);
        progressBar.style.width = p + '%';
        progressText.textContent = Math.round(p) + '%';
        progressTimer = requestAnimationFrame(tick);
        return;
      }
      const elapsed = now - stepStart;
      const t = Math.min(elapsed / step.duration, 1);
      // ease-out quad
      const ease = t * (2 - t);
      p = stepStartP + (step.target - stepStartP) * ease;
      progressBar.style.width = p + '%';
      progressText.textContent = Math.round(p) + '%';
      if (t >= 1) {
        stepStartP = step.target;
        stepIdx++;
        stepStart = now;
      }
      progressTimer = requestAnimationFrame(tick);
    }
    progressTimer = requestAnimationFrame(tick);
  }

  // Warm up the CDN connection before loading
  function warmupCDN(src) {
    try {
      const url = new URL(src);
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = url.origin;
      link.crossOrigin = 'anonymous';
      document.head.appendChild(link);
    } catch {}
  }

  function loadGame() {
    if (iframeLoaded || !gameIframe || !gameCover) return;
    iframeLoaded = true;

    // Warmup CDN
    let src = gameIframe.dataset.src;
    if (src) warmupCDN(src);

    // Append language parameter for game iframes (best-effort)
    const lang = localStorage.getItem('i18n_lang') || 'en';
    if (lang !== 'en' && src) {
      try {
        const url = new URL(src);
        url.searchParams.set('lang', lang);
        src = url.toString();
      } catch(e) {}
    }

    // Show loading overlay with progress animation
    gameCover.style.display = 'none';
    gameLoading.classList.remove('hidden');
    startProgressSimulation();

    // Small delay then set src (let progress bar show first)
    setTimeout(() => {
      gameIframe.src = src;
      gameIframe.classList.remove('pointer-events-none');
      gameIframe.removeAttribute('data-src');
    }, 100);
  }

  if (gameCover && gameIframe) {
    gameCover.addEventListener('click', function(e) {
      loadGame();
      // Auto fullscreen on mobile (CSS fallback for iOS where Fullscreen API not supported on <div>)
      const isMobile = window.innerWidth < 768 || 'ontouchstart' in window;
      if (isMobile) {
        const gc = document.getElementById('game-container');
        if (gc) requestFullscreen(gc);
      }
    });
    // Also allow keyboard activation
    gameCover.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); loadGame(); }
    });
    gameCover.setAttribute('tabindex', '0');
    gameCover.setAttribute('role', 'button');
  }

  // Complete progress and hide loader once iframe loads
  let loadTimedOut = false;

  function hideLoading() {
    if (progressTimer) cancelAnimationFrame(progressTimer);
    if (progressBar) progressBar.style.width = '100%';
    if (progressText) progressText.textContent = '100%';
    if (gameLoading) {
      gameLoading.style.transition = 'opacity 0.3s';
      gameLoading.style.opacity = '0';
      setTimeout(() => { gameLoading.style.display = 'none'; }, 300);
    }
  }

  if (gameIframe) {
    gameIframe.addEventListener('load', function() {
      loadTimedOut = true;
      hideLoading();
    });
    gameIframe.addEventListener('error', function() {
      loadTimedOut = true;
      hideLoading();
    });
  }

  // Safety timeout: force-hide loading after 20s even if iframe load event never fires
  setTimeout(() => {
    if (gameLoading && gameLoading.style.display !== 'none' && !loadTimedOut) {
      hideLoading();
    }
  }, 20000);

  // === Fullscreen toggle for mobile (with CSS fallback for iOS) ===
  const fsBtn = document.getElementById('fs-btn');
  const fsEnter = document.getElementById('fs-enter');
  const gameContainer = document.getElementById('game-container');

  let fsMode = false; // tracks CSS fallback fullscreen

  function isFs() {
    return !!(document.fullscreenElement || document.webkitFullscreenElement || fsMode);
  }

  function requestFullscreen(el) {
    if (el.requestFullscreen) {
      el.requestFullscreen().catch(function(){ fallbackFs(el); });
    } else if (el.webkitRequestFullscreen) {
      el.webkitRequestFullscreen();
    } else {
      fallbackFs(el);
    }
  }

  function exitFullscreen() {
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else if (document.webkitFullscreenElement) {
      document.webkitExitFullscreen();
    }
    exitFallbackFs();
  }

  function fallbackFs(el) {
    el.classList.add('fs-mode');
    document.body.style.overflow = 'hidden';
    fsMode = true;
  }

  function exitFallbackFs() {
    gameContainer.classList.remove('fs-mode');
    document.body.style.overflow = '';
    fsMode = false;
  }

  function updateFsButton() {
    if (!fsBtn) return;
    const mobile = window.innerWidth < 768;
    if (mobile && iframeLoaded) {
      fsBtn.classList.remove('hidden');
      fsBtn.classList.add('flex');
    } else {
      fsBtn.classList.add('hidden');
      fsBtn.classList.remove('flex');
    }
    if (fsEnter) {
      fsEnter.setAttribute('d', isFs()
        ? 'M6 18L18 6M6 6l12 12'
        : 'M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5'
      );
    }
  }

  if (fsBtn && gameContainer) {
    fsBtn.addEventListener('click', function() {
      if (isFs()) {
        exitFullscreen();
      } else {
        requestFullscreen(gameContainer);
      }
    });
    document.addEventListener('fullscreenchange', updateFsButton);
    document.addEventListener('webkitfullscreenchange', updateFsButton);
    // Poll for fs-mode class changes (CSS fallback not covered by fullscreenchange events)
    var fsCheckTimer = setInterval(function() {
      if (iframeLoaded) {
        updateFsButton();
        clearInterval(fsCheckTimer);
      }
    }, 500);
  }

  // === Recently Played ===
  try {
    const recent = JSON.parse(localStorage.getItem('recent') || '[]');
    const updated = [{ slug, title, category, playedAt: Date.now() }]
      .concat(recent.filter(r => r.slug !== slug))
      .slice(0, 20);
    localStorage.setItem('recent', JSON.stringify(updated));
  } catch {}

  // === Favorites ===
  const favBtn = document.getElementById('fav-btn');
  const favIcon = document.getElementById('fav-icon');
  const favLabel = document.getElementById('fav-label');

  function getFavorites() {
    try { return JSON.parse(localStorage.getItem('favorites') || '[]'); }
    catch { return []; }
  }

  function updateFavButton() {
    const favs = getFavorites();
    const isFav = favs.some(f => f.slug === slug);
    favIcon.textContent = isFav ? '❤️' : '🤍';
    favLabel.textContent = window.__ ? (isFav ? window.__('game.saved') : window.__('game.save')) : (isFav ? 'Saved' : 'Save');
    favBtn.classList.toggle('bg-red-50', isFav);
    favBtn.classList.toggle('dark:bg-red-900/20', isFav);
    favBtn.classList.toggle('border-red-200', isFav);
    favBtn.classList.toggle('dark:border-red-800', isFav);
    favBtn.classList.toggle('text-red-600', isFav);
    favBtn.classList.toggle('dark:text-red-400', isFav);
  }

  if (favBtn) {
    updateFavButton();
    favBtn.addEventListener('click', () => {
      let favs = getFavorites();
      const idx = favs.findIndex(f => f.slug === slug);
      if (idx >= 0) {
        favs.splice(idx, 1);
      } else {
        favs.unshift({ slug, title, category, addedAt: Date.now() });
      }
      localStorage.setItem('favorites', JSON.stringify(favs));
      updateFavButton();
    });
  }
</script>
