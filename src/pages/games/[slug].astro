---
import Layout from '../../layouts/Layout.astro';
import GameGrid from '../../components/GameGrid.astro';
import type { Game } from '../../data/games';
import gamesData from '../../data/games.json' with { type: 'json' };

export async function getStaticPaths() {
  return (gamesData as Game[]).map((game: Game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const allGames = gamesData as Game[];

// Related games from same category
const related = allGames
  .filter((g: Game) => g.category === game.category && g.slug !== game.slug)
  .slice(0, 8);

const canonicalUrl = `https://chillarcade.io/games/${game.slug}`;
---

<Layout title={game.title} description={game.shortDescription} canonical={canonicalUrl}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-4">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
    <span>/</span>
    <a href={`/category/${game.category}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors capitalize">{game.category}</a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300">{game.title}</span>
  </nav>

  <!-- Game Header -->
  <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-8">
    <div class="p-6 pb-0">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100">{game.title}</h1>
          <div class="flex items-center gap-3 mt-2">
            <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-3 py-1 rounded-full capitalize">{game.category}</span>
            <span class="text-sm text-slate-400">⭐ {game.rating || 4.0}</span>
            <span class="text-sm text-slate-400">👥 {(game.playCount || 0).toLocaleString()} plays</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Game iframe area -->
    <div class="w-full bg-slate-900 flex items-center justify-center">
      <div class="w-full max-w-4xl mx-auto aspect-[4/3] md:aspect-[16/9] flex items-center justify-center">
        {game.iframeUrl ? (
          <iframe src={game.iframeUrl} class="w-full h-full" allow="autoplay; fullscreen" allowfullscreen sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
        ) : (
          <div class="text-center p-8">
            <div class="text-6xl mb-4">🎮</div>
            <p class="text-slate-300 text-lg font-medium">Game Loading...</p>
            <p class="text-slate-400 text-sm mt-2">Click the button below to start playing</p>
            <button class="mt-4 px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-all hover:scale-105 shadow-lg">
              ▶ Play Now
            </button>
          </div>
        )}
      </div>
    </div>

    <!-- Game description and instructions -->
    <div class="p-6">
      <div class="prose prose-slate dark:prose-invert max-w-none">
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{game.description}</p>
      </div>

      {game.instructions && (
        <div class="mt-6">
          <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-3">📖 How to Play</h2>
          <p class="text-slate-600 dark:text-slate-300">{game.instructions}</p>
        </div>
      )}

      <div class="flex flex-wrap gap-2 mt-6">
        {game.tags?.map(tag => (
          <span class="text-xs bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 px-3 py-1 rounded-full">#{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Guide Section -->
  {game.guideTitle && game.guideContent && (
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-8 p-6">
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-4">📝 {game.guideTitle}</h2>
      <div class="text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-line">
        {game.guideContent}
      </div>
    </div>
  )}

  <!-- Related Games -->
  {related.length > 0 && (
    <section>
      <GameGrid games={related} cols={4} title="🎯 You May Also Like" />
    </section>
  )}

  <!-- Game Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": game.title,
    "description": game.shortDescription,
    "genre": game.category,
    "applicationCategory": "Game",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />
</Layout>
