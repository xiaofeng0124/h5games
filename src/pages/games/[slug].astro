---
import Layout from '../../layouts/Layout.astro';
import GameGrid from '../../components/GameGrid.astro';
import type { Game } from '../../data/games';
import gamesData from '../../data/games.json' with { type: 'json' };

export async function getStaticPaths() {
  return (gamesData as Game[]).map((game: Game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const allGames = gamesData as Game[];

// Related games from same category
const related = allGames
  .filter((g: Game) => g.category === game.category && g.slug !== game.slug)
  .slice(0, 8);

const canonicalUrl = `https://chillarcade.io/games/${game.slug}`;
---

<Layout title={game.title} description={game.shortDescription} canonical={canonicalUrl}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-4">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <a href={`/category/${game.category}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors capitalize"><span data-i18n={`cat.${game.category}`}>{game.category}</span></a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300">{game.title}</span>
  </nav>

  <!-- Game Header -->
  <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-8">
    <div class="p-6 pb-0">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100">{game.title}</h1>
          <div class="flex items-center gap-3 mt-2">
            <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-3 py-1 rounded-full capitalize"><span data-i18n={`cat.${game.category}`}>{game.category}</span></span>
            <span class="text-sm text-slate-400">⭐ {game.rating || 4.0}</span>
            <span class="text-sm text-slate-400">👥 {(game.playCount || 0).toLocaleString()} plays</span>
          </div>
        </div>
        <button id="fav-btn" data-slug={game.slug}
          class="flex items-center gap-1.5 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-600 text-sm font-medium transition-all hover:scale-105"
          aria-label="Add to favorites">
          <span id="fav-icon" class="text-lg">🤍</span>
          <span id="fav-label" data-i18n="game.save">Save</span>
        </button>
      </div>
    </div>

    <!-- Game iframe area -->
    <div class="w-full bg-slate-900 flex items-center justify-center relative">
      <!-- Loading spinner -->
      <div id="game-loading" class="absolute inset-0 flex flex-col items-center justify-center z-10">
        <div class="w-12 h-12 border-4 border-slate-600 border-t-indigo-500 rounded-full animate-spin mb-4"></div>
        <p class="text-slate-400 text-sm" data-i18n="game.loading">Loading game...</p>
      </div>
      <div class="w-full max-w-4xl mx-auto aspect-[4/3] md:aspect-[16/9] flex items-center justify-center">
        {game.iframeUrl ? (
          <iframe src={game.iframeUrl} class="w-full h-full relative z-20" allow="autoplay *; fullscreen *" allowfullscreen sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-pointer-lock allow-modals" onload="document.getElementById('game-loading').style.display='none'"></iframe>
        ) : (
          <div class="text-center p-8">
            <div class="text-6xl mb-4">🎮</div>
            <p class="text-slate-300 text-lg font-medium" data-i18n="game.loading_title">Game Loading...</p>
            <p class="text-slate-400 text-sm mt-2" data-i18n="game.click_play">Click the button below to start playing</p>
            <button class="mt-4 px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-all hover:scale-105 shadow-lg" data-i18n="game.playnow">
              ▶ Play Now
            </button>
          </div>
        )}
      </div>
    </div>

    <!-- Game description and instructions -->
    <div class="p-6">
      <div class="prose prose-slate dark:prose-invert max-w-none">
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{game.description}</p>
      </div>

      {game.instructions && (
        <div class="mt-6">
          <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-3" data-i18n="game.howtoplay">📖 How to Play</h2>
          <p class="text-slate-600 dark:text-slate-300">{game.instructions}</p>
        </div>
      )}

      <div class="flex flex-wrap gap-2 mt-6">
        {game.tags?.map(tag => (
          <span class="text-xs bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 px-3 py-1 rounded-full">#{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Guide Section -->
  {game.guideTitle && game.guideContent && (
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-8 p-6">
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-4">📝 {game.guideTitle}</h2>
      <div class="text-slate-600 dark:text-slate-300 leading-relaxed space-y-3 [&_strong]:text-slate-800 dark:[&_strong]:text-slate-200 [&_p]:mb-3 last:[&_p]:mb-0" set:html={game.guideContent}>
      </div>
    </div>
  )}

  <!-- Related Games -->
  {related.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-6" data-i18n="game.related">🎯 You May Also Like</h2>
      <GameGrid games={related} cols={4} />
    </section>
  )}

  <!-- Game Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": game.title,
    "description": game.shortDescription,
    "genre": game.category,
    "applicationCategory": "Game",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />
</Layout>

<script>
  const slug = '{game.slug}';
  const title = '{game.title}';
  const category = '{game.category}';

  // === Recently Played ===
  try {
    const recent = JSON.parse(localStorage.getItem('recent') || '[]');
    const updated = [{ slug, title, category, playedAt: Date.now() }]
      .concat(recent.filter(r => r.slug !== slug))
      .slice(0, 20);
    localStorage.setItem('recent', JSON.stringify(updated));
  } catch {}

  // === Favorites ===
  const favBtn = document.getElementById('fav-btn');
  const favIcon = document.getElementById('fav-icon');
  const favLabel = document.getElementById('fav-label');

  function getFavorites() {
    try { return JSON.parse(localStorage.getItem('favorites') || '[]'); }
    catch { return []; }
  }

  function updateFavButton() {
    const favs = getFavorites();
    const isFav = favs.some(f => f.slug === slug);
    favIcon.textContent = isFav ? '❤️' : '🤍';
    favLabel.textContent = window.__ ? (isFav ? window.__('game.saved') : window.__('game.save')) : (isFav ? 'Saved' : 'Save');
    favBtn.classList.toggle('bg-red-50', isFav);
    favBtn.classList.toggle('dark:bg-red-900/20', isFav);
    favBtn.classList.toggle('border-red-200', isFav);
    favBtn.classList.toggle('dark:border-red-800', isFav);
    favBtn.classList.toggle('text-red-600', isFav);
    favBtn.classList.toggle('dark:text-red-400', isFav);
  }

  if (favBtn) {
    updateFavButton();
    favBtn.addEventListener('click', () => {
      let favs = getFavorites();
      const idx = favs.findIndex(f => f.slug === slug);
      if (idx >= 0) {
        favs.splice(idx, 1);
      } else {
        favs.unshift({ slug, title, category, addedAt: Date.now() });
      }
      localStorage.setItem('favorites', JSON.stringify(favs));
      updateFavButton();
    });
  }
</script>
