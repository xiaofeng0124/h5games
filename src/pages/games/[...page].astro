---
import Layout from '../../layouts/Layout.astro';
import SearchAutocomplete from '../../components/SearchAutocomplete.astro';
import GameCard from '../../components/GameCard.astro';
import Pagination from '../../components/Pagination.astro';
import allGames from '../../data/games.json' with { type: 'json' };
import categories from '../../data/categories.json' with { type: 'json' };
import { tagCN, emojiMap } from '../../data/constants';
import fs from 'node:fs';

const PER_PAGE = 48;
const totalPages = Math.ceil(allGames.length / PER_PAGE);

export async function getStaticPaths() {
  const g = JSON.parse(fs.readFileSync('src/data/games.json', 'utf-8'));
  const total = Math.ceil(g.length / 48);
  const paths = [{ params: { page: undefined } }];
  for (let i = 2; i <= total; i++) {
    paths.push({ params: { page: String(i) } });
  }
  return paths;
}

const { page } = Astro.props;
const currentPage = page ? parseInt(page as string, 10) : 1;
const start = (currentPage - 1) * PER_PAGE;
const end = Math.min(start + PER_PAGE, allGames.length);
const pageGames = allGames.slice(start, end);
const categoryEntries = Object.entries(categories) as [string, { name: string; description: string; icon: string }][];

// 预计算标签数据
const tagCounts: Record<string, number> = {};
for (const g of allGames) {
  if (g.tags) {
    for (const t of g.tags) {
      tagCounts[t] = (tagCounts[t] || 0) + 1;
    }
  }
}
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 24);
// Always include snooker tag
if (!topTags.some(t => t[0] === 'snooker')) {
  topTags.push(['snooker', tagCounts['snooker'] || 27]);
}
// Image optimization for preload
function preloadSrc(img: string | undefined, size: number): string {
  if (!img) return '';
  return img.includes('img.gamepix.com')
    ? img + (img.includes('?') ? '&' : '?') + `w=${size}&h=${Math.round(size*0.75)}&fit=crop&auto=format&q=75`
    : img;
}
const firstPage = currentPage === 1;
---

<Layout title={`Browse All Free Online Games - Page ${currentPage}`} description={`Browse ${allGames.length} free online games. Page ${currentPage} of ${totalPages}. Play instantly in your browser, no downloads needed.`}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300 font-medium" data-i18n="nav.browse">All Games</span>
  </nav>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 mb-2">
      🎮 <span data-i18n="nav.browse">All Games</span>
    </h1>
    <p class="text-slate-500 dark:text-slate-400">
      <span class="font-semibold text-indigo-600 dark:text-indigo-400">{allGames.length}</span> free online games — page {currentPage} of {totalPages}
    </p>
  </div>

  <!-- Search & Filter -->
  <section class="mb-8">
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
      <div class="flex flex-col sm:flex-row gap-2">
        <SearchAutocomplete />
        <select id="category-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          <option value="" data-i18n="filter.all">All Categories</option>
          {categoryEntries.map(([slug, cat]) => (
            <option value={slug} data-i18n={`cat.${slug}`}>{cat.name}</option>
          ))}
        </select>
      </div>
      <div id="search-results-info" class="mt-1 text-xs text-slate-400 hidden">
        <span id="result-count">0</span> <span data-i18n="search.found">games found</span>
      </div>
    </div>
    <!-- Tag filter -->
    <div id="tag-filter" class="flex flex-wrap gap-1.5 mt-2">
      {topTags.map(([tag, count]) => (
        <button data-tag={tag} data-cn={tagCN[tag] || tag} class="tag-chip px-2.5 py-1 text-xs font-medium rounded-full border border-slate-200 dark:border-slate-600 text-slate-500 dark:text-slate-400 hover:border-indigo-300 dark:hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all whitespace-nowrap">
          {tag} ({count})
        </button>
      ))}
    </div>
  </section>

  <!-- Game Grid -->
  {firstPage && pageGames.slice(0, 12).map(g => g.image ? (
    <link rel="preload" as="image" href={preloadSrc(g.image, 320)} />
  ) : null)}
  <section class="mb-8">
    <div id="games-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-2">
      {pageGames.map((game, idx) => (
        <GameCard
          slug={game.slug}
          title={game.title}
          category={game.category}
          image={game.image}
          description={game.shortDescription}
          iframeUrl={game.iframeUrl}
          difficulty={game.difficulty}
          compact={true}
          priority={currentPage === 1 && idx < 24}
        />
      ))}
    </div>
  </section>

  <!-- Pagination -->
  <section class="mb-12">
    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/games" />
  </section>

  <!-- Game search data (lazy loaded when search/filter is used) -->
  <script is:inline>
    (function(){
      var data = null;
      try { var c = JSON.parse(localStorage.getItem('sd')); if (c && c.d && Array.isArray(c.d)) { if (c.d[0] && c.d[0].slug !== undefined) { localStorage.removeItem('sd'); localStorage.removeItem('sdv'); } else { data = c.d; window.__gamesData = c.d; } } } catch(e){}
      if (data) { window.__gamesDataPromise = Promise.resolve(data); return; }
      window.__gamesData = [];
      window.__gamesDataPromise = new Promise(function(r){ window.__resolveGamesData = r; });
      window.__lazyLoadGamesData = function() {
        if (!window.__lazyLoadGamesData__pending) {
          window.__lazyLoadGamesData__pending = true;
          fetch('/search-data-version.json?' + Date.now()).then(function(r){ return r.json(); }).then(function(v){
            return fetch('/search-data.json?' + Date.now()).then(function(r){ return r.text(); }).then(function(text){
              setTimeout(function() {
                var d;
                try { d = JSON.parse(text); } catch(e) { d = []; }
                window.__gamesData = d;
                try { localStorage.setItem('sd', JSON.stringify({d:d})); localStorage.setItem('sdv', v.hash); } catch(e){}
                if (window.__resolveGamesData) window.__resolveGamesData(d);
              }, 0);
            });
          }).catch(function(){
            if (!window.__gamesData) window.__gamesData = [];
            if (window.__resolveGamesData) window.__resolveGamesData(window.__gamesData);
            return window.__gamesData;
          });
        }
        return window.__gamesDataPromise;
      };
      // Preload during idle time so data is ready when user searches
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { window.__lazyLoadGamesData(); }, { timeout: 3000 });
      } else {
        setTimeout(function() { window.__lazyLoadGamesData(); }, 2000);
      }

    })();
  </script>
</Layout>

<script>
  window.__initPage = function() {
  const searchInput = document.getElementById('search-input');
  const categoryFilter = document.getElementById('category-filter');
  const tagFilter = document.getElementById('tag-filter');
  const resultsInfo = document.getElementById('search-results-info');
  const resultCount = document.getElementById('result-count');
  const gamesGrid = document.getElementById('games-grid');

  let selectedTag = '';
  let allGamesData = window.__gamesData || [];

  // When search data finishes loading, re-run any active filter
  (window.__gamesDataPromise || Promise.resolve([])).then(function(data) {
    allGamesData = data;
    if (searchInput?.value || categoryFilter?.value || selectedTag) {
      filterGames();
    }
  });

  // 标签点击筛选（标签按钮已预渲染，只需事件绑定）
  tagFilter?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tag]');
    if (!btn) return;
    const tag = btn.getAttribute('data-tag');
    if (selectedTag === tag) {
      selectedTag = '';
      btn.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
      btn.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
    } else {
      tagFilter.querySelectorAll('[data-tag]').forEach(b => {
        b.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
        b.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
      });
      selectedTag = tag;
      btn.classList.remove('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
      btn.classList.add('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
    }
    filterGames();
  });

  // 语言切换时更新标签文字
  function updateTagLabels() {
    const lang = localStorage.getItem('i18n_lang') || 'en';
    tagFilter?.querySelectorAll('[data-tag][data-cn]').forEach(el => {
      const en = el.getAttribute('data-tag');
      const cn = el.getAttribute('data-cn');
      const count = el.textContent.match(/\((\d+)\)/);
      const cnt = count ? count[1] : '';
      const label = (lang === 'zh' || lang === 'zh-tw') ? (cn || en) : en;
      el.textContent = label + ' (' + cnt + ')';
    });
  }
  updateTagLabels();

  function renderGames(games) {
    if (!gamesGrid) return;
    if (games.length === 0) {
      gamesGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg mb-1">😕</p><p data-i18n="search.noresults">No games found. Try a different search.</p></div>';
      return;
    }
    function optImg(url, size) {
      if (!url || url.indexOf('img.gamepix.com') === -1) return url || '';
      return url + (url.indexOf('?') >= 0 ? '&' : '?') + 'w=' + size + '&h=' + Math.round(size * 0.75) + '&fit=crop&auto=format&q=75';
    }
    const emojiMap = {'match-3':'🍬','puzzle':'🧩','merge':'🧪','casual':'🎮','arcade':'👾','word':'🔤','card':'🃏','hidden-object':'🔍','board':'♟️','strategy':'🎯','adventure':'⚔️','sports':'⚽','racing':'🏎️','action':'🎯','fighting':'🥊','multiplayer':'👥','idle':'📈'};
    gamesGrid.innerHTML = games.map(g => `
      <a href="/games/${g.s}" class="gc">
        <div class="gc-thumb">
          ${g.i
            ? `<img src="${optImg(g.i, 240)}" alt="${g.t}" loading="lazy" decoding="async" width="240" height="180" />`
            : `<span class="gc-icon">${emojiMap[g.c] || '🎮'}</span>`
          }
          <div class="gc-overlay">
            <div class="gc-play">
              <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <span class="gc-title">${g.t}</span>
      </a>
    `).join('');
    gamesGrid.querySelectorAll('.gc').forEach(function(el) {
      if (!el.classList.contains('visible')) el.classList.add('visible');
    });
  }

  function filterGames() {
    if (window.__lazyLoadGamesData) window.__lazyLoadGamesData();
    const query = (searchInput?.value || '').trim().toLowerCase();
    const category = categoryFilter?.value || '';

    const filtered = allGamesData.filter(g => {
      const matchCategory = !category || g.c === category;
      const matchTag = !selectedTag || (g.tg && g.tg.includes(selectedTag));
      const matchSearch = !query ||
        g.t.toLowerCase().includes(query) ||
        g.c.includes(query) ||
        (g.tg && g.tg.some(t => t.includes(query)));
      return matchCategory && matchTag && matchSearch;
    }).sort((a, b) => {
      const order = { gd: 0, gm: 1, gp: 2 };
      return (order[a.p] ?? 2) - (order[b.p] ?? 2);
    });

    if (resultsInfo && resultCount) {
      if (query || category || selectedTag) {
        resultsInfo.classList.remove('hidden');
        resultCount.textContent = filtered.length;
      } else {
        resultsInfo.classList.add('hidden');
      }
    }

    renderGames(filtered);
  }

  searchInput?.addEventListener('input', filterGames);
  categoryFilter?.addEventListener('change', filterGames);
  };
  window.__initPage();
</script>
