---
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import Pagination from '../../components/Pagination.astro';
import allGames from '../../data/games.json' with { type: 'json' };
import categories from '../../data/categories.json' with { type: 'json' };
import fs from 'node:fs';

const PER_PAGE = 48;
const totalPages = Math.ceil(allGames.length / PER_PAGE);

export async function getStaticPaths() {
  const g = JSON.parse(fs.readFileSync('src/data/games.json', 'utf-8'));
  const total = Math.ceil(g.length / 48);
  const paths = [{ params: { page: undefined } }];
  for (let i = 2; i <= total; i++) {
    paths.push({ params: { page: String(i) } });
  }
  return paths;
}

const { page } = Astro.props;
const currentPage = page ? parseInt(page as string, 10) : 1;
const start = (currentPage - 1) * PER_PAGE;
const end = Math.min(start + PER_PAGE, allGames.length);
const pageGames = allGames.slice(start, end);
const categoryEntries = Object.entries(categories) as [string, { name: string; description: string; icon: string }][];
const emojiMap: Record<string, string> = {
  'match-3': '🍬', 'puzzle': '🧩', 'merge': '🧪', 'casual': '🎮', 'arcade': '👾',
  'word': '🔤', 'card': '🃏', 'hidden-object': '🔍', 'board': '♟️', 'strategy': '🎯',
  'adventure': '⚔️', 'sports': '⚽', 'racing': '🏎️', 'action': '🎯', 'fighting': '🥊',
  'multiplayer': '👥', 'idle': '📈',
};
---

<Layout title={`Browse All Free Online Games - Page ${currentPage}`} description={`Browse ${allGames.length} free online games. Page ${currentPage} of ${totalPages}. Play instantly in your browser, no downloads needed.`}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300 font-medium" data-i18n="nav.browse">All Games</span>
  </nav>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 mb-2">
      🎮 <span data-i18n="nav.browse">All Games</span>
    </h1>
    <p class="text-slate-500 dark:text-slate-400">
      <span class="font-semibold text-indigo-600 dark:text-indigo-400">{allGames.length}</span> free online games — page {currentPage} of {totalPages}
    </p>
  </div>

  <!-- Search & Filter -->
  <section class="mb-8">
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
      <div class="flex flex-col sm:flex-row gap-2">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="search-input" data-i18n="search.placeholder" data-i18n-attr="placeholder" placeholder="Search {allGames.length} games..." class="w-full pl-9 pr-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent" />
        </div>
        <select id="category-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          <option value="" data-i18n="filter.all">All Categories</option>
          {categoryEntries.map(([slug, cat]) => (
            <option value={slug} data-i18n={`cat.${slug}`}>{cat.name}</option>
          ))}
        </select>
        <select id="difficulty-filter" class="px-3 py-2 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          <option value="" data-i18n="filter.all">All Difficulties</option>
          <option value="easy" data-i18n="filter.easy">Easy</option>
          <option value="medium" data-i18n="filter.medium">Medium</option>
          <option value="hard" data-i18n="filter.hard">Hard</option>
        </select>
      </div>
      <div id="search-results-info" class="mt-1 text-xs text-slate-400 hidden">
        <span id="result-count">0</span> <span data-i18n="search.found">games found</span>
      </div>
    </div>
    <!-- Tag filter -->
    <div id="tag-filter" class="flex flex-wrap gap-1.5 mt-2"></div>
  </section>

  <!-- Game Grid -->
  <section class="mb-8">
    <div id="games-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-2">
      {pageGames.map(game => (
        <GameCard
          slug={game.slug}
          title={game.title}
          category={game.category}
          image={game.image}
          description={game.shortDescription}
          iframeUrl={game.iframeUrl}
          difficulty={game.difficulty}
          compact={true}
        />
      ))}
    </div>
  </section>

  <!-- Pagination -->
  <section class="mb-12">
    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/games" />
  </section>

  <!-- All game data for client-side search -->
  <script type="application/json" id="games-data">
    {JSON.stringify(allGames.map(g => ({
      slug: g.slug,
      title: g.title,
      category: g.category,
      description: g.shortDescription,
      difficulty: g.difficulty || '',
      tags: g.tags || [],
      image: g.image,
      iframeUrl: g.iframeUrl,
    })))}
  </script>
</Layout>

<script>
  const searchInput = document.getElementById('search-input');
  const categoryFilter = document.getElementById('category-filter');
  const difficultyFilter = document.getElementById('difficulty-filter');
  const tagFilter = document.getElementById('tag-filter');
  const resultsInfo = document.getElementById('search-results-info');
  const resultCount = document.getElementById('result-count');
  const gamesGrid = document.getElementById('games-grid');

  let selectedTag = '';
  let allGamesData = [];
  try {
    const el = document.getElementById('games-data');
    if (el) allGamesData = JSON.parse(el.textContent);
  } catch(e) {}

  // Build tag filter chips from game data
  function buildTagFilter() {
    if (!tagFilter || !allGamesData.length) return;
    const counts = {};
    allGamesData.forEach(g => {
      if (g.tags) g.tags.forEach(t => { counts[t] = (counts[t] || 0) + 1; });
    });
    const sorted = Object.entries(counts).sort((a,b) => b[1] - a[1]).slice(0, 24);
    tagFilter.innerHTML = sorted.map(([tag, count]) =>
      `<button data-tag="${tag}" class="tag-chip px-2.5 py-1 text-xs font-medium rounded-full border border-slate-200 dark:border-slate-600 text-slate-500 dark:text-slate-400 hover:border-indigo-300 dark:hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all whitespace-nowrap">${tag} (${count})</button>`
    ).join('');
    tagFilter.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-tag]');
      if (!btn) return;
      const tag = btn.getAttribute('data-tag');
      if (selectedTag === tag) {
        selectedTag = '';
        btn.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
        btn.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
      } else {
        tagFilter.querySelectorAll('[data-tag]').forEach(b => {
          b.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
          b.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
        });
        selectedTag = tag;
        btn.classList.remove('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
        btn.classList.add('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
      }
      filterGames();
    });
  }

  function renderGames(games) {
    if (!gamesGrid) return;
    if (games.length === 0) {
      gamesGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg mb-1">😕</p><p data-i18n="search.noresults">No games found. Try a different search.</p></div>';
      return;
    }
    const emojiMap = {'match-3':'🍬','puzzle':'🧩','merge':'🧪','casual':'🎮','arcade':'👾','word':'🔤','card':'🃏','hidden-object':'🔍','board':'♟️','strategy':'🎯','adventure':'⚔️','sports':'⚽','racing':'🏎️','action':'🎯','fighting':'🥊','multiplayer':'👥','idle':'📈'};
    gamesGrid.innerHTML = games.map(g => `
      <a href="/games/${g.slug}" class="gc group block bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-600 transition-all duration-200">
        <div class="relative aspect-[4/3] bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-indigo-900 dark:to-purple-900 overflow-hidden flex items-center justify-center">
          ${g.image
            ? `<img src="${g.image}" alt="${g.title}" class="w-full h-full object-cover" loading="lazy" decoding="async" />`
            : `<span class="text-4xl">${emojiMap[g.category] || '🎮'}</span>`
          }
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 flex items-center justify-center transition-colors duration-200">
            <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 w-10 h-10 bg-white/90 rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-5 h-5 text-indigo-600 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <div class="p-2">
          <h3 class="text-xs font-medium text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1 text-center">${g.title}</h3>
        </div>
      </a>
    `).join('');
  }

  function filterGames() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    const category = categoryFilter?.value || '';
    const difficulty = difficultyFilter?.value || '';

    const filtered = allGamesData.filter(g => {
      const matchCategory = !category || g.category === category;
      const matchDifficulty = !difficulty || g.difficulty === difficulty;
      const matchTag = !selectedTag || (g.tags && g.tags.includes(selectedTag));
      const matchSearch = !query ||
        g.title.toLowerCase().includes(query) ||
        g.description.toLowerCase().includes(query) ||
        g.category.includes(query) ||
        (g.tags && g.tags.some(t => t.includes(query)));
      return matchCategory && matchDifficulty && matchTag && matchSearch;
    });

    if (resultsInfo && resultCount) {
      if (query || category || difficulty || selectedTag) {
        resultsInfo.classList.remove('hidden');
        resultCount.textContent = filtered.length;
      } else {
        resultsInfo.classList.add('hidden');
      }
    }

    renderGames(filtered);
  }

  searchInput?.addEventListener('input', filterGames);
  categoryFilter?.addEventListener('change', filterGames);
  difficultyFilter?.addEventListener('change', filterGames);

  if (allGamesData.length) buildTagFilter();
</script>
