---
import Layout from '../layouts/Layout.astro';
import SearchAutocomplete from '../components/SearchAutocomplete.astro';
import games from '../data/games.json' with { type: 'json' };
import categories from '../data/categories.json' with { type: 'json' };

const popular = games
  .filter(g => g.playCount && g.playCount > 5000)
  .sort((a, b) => (b.playCount || 0) - (a.playCount || 0))
  .slice(0, 12);

const catEntries = Object.entries(categories).slice(0, 8);
---

<Layout title="Page Not Found (404) - Chill Arcade" description="The page you're looking for doesn't exist. Browse thousands of free online games instead.">
  <div class="max-w-3xl mx-auto text-center py-12 md:py-20">
    <!-- Icon -->
    <div class="text-7xl md:text-8xl mb-6">🎮</div>

    <h1 class="text-3xl md:text-5xl font-extrabold text-slate-800 dark:text-slate-100 mb-3" data-i18n="404.title">Game Over?</h1>
    <p class="text-lg text-slate-500 dark:text-slate-400 mb-2" data-i18n="404.subtitle">We couldn't find the page you were looking for.</p>
    <p class="text-sm text-slate-400 dark:text-slate-500 mb-8" data-i18n="404.hint">It might have moved, or the link may be broken. Let's get you back in the game.</p>

    <!-- Search -->
    <div class="max-w-md mx-auto mb-10">
      <SearchAutocomplete />
    </div>

    <!-- Quick categories -->
    <div class="mb-10">
      <h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4" data-i18n="nav.categories">Browse by Category</h2>
      <div class="flex flex-wrap justify-center gap-2">
        {catEntries.map(([slug, cat]) => (
          <a href={`/category/${slug}`} class="inline-flex items-center gap-1.5 px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full text-sm font-medium text-slate-600 dark:text-slate-300 hover:border-indigo-300 dark:hover:border-indigo-600 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all shadow-sm hover:shadow">
            <span>{cat.icon}</span>
            <span><span data-i18n={`cat.${slug}`}>{cat.name}</span></span>
          </a>
        ))}
      </div>
      <a href="/games" class="inline-block mt-4 text-sm text-indigo-600 dark:text-indigo-400 hover:underline">
        ← <span data-i18n="view_all">View All Games</span>
      </a>
    </div>

    <!-- Popular games -->
    <div>
      <h2 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4"><span data-i18n="404.popular">Popular Right Now</span></h2>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2">
        {popular.map((game, idx) => (
          <a href={`/games/${game.slug}`} class="gc group">
            <div class="gc-thumb">
              {game.image
                ? <img src={game.image} alt={game.title} loading="lazy" decoding="async" width="240" height="180" onerror="this.style.display='none'" />
                : <span class="gc-icon" style="font-size:1.5rem">🎮</span>
              }
              <div class="gc-overlay">
                <div class="gc-play">
                  <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <span class="gc-title">{game.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
