---
import Layout from '../../layouts/Layout.astro';
import blogPosts from '../../data/blog.json' with { type: 'json' };
import type { BlogPost } from '../../data/games';
import { marked } from 'marked';

export async function getStaticPaths() {
  return blogPosts.map((post: BlogPost) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const renderedContent = marked.parse(post.content, { async: false }) as string;
---

<Layout title={post.title} description={post.description}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <a href="/blog" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.guides">Guides</a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300">{post.title}</span>
  </nav>

  <article class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="p-6 md:p-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-3 py-1 rounded-full capitalize">{post.category}</span>
        <span class="text-xs text-slate-400">{post.date}</span>
        <span class="text-xs text-slate-400">{post.readTime} read</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 mb-6">{post.title}</h1>

      <div class="prose max-w-none text-slate-800 dark:text-slate-200 leading-relaxed [&_a]:text-indigo-600 dark:[&_a]:text-indigo-400 [&_a]:underline [&_a]:font-medium [&_a:hover]:text-indigo-800 dark:[&_a:hover]:text-indigo-300 blog-content" set:html={renderedContent}>
      </div>
    </div>
  </article>

  <!-- Back link -->
  <div class="mt-6">
    <a href="/blog" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium"><span data-i18n="blog.back">← Back to Guides</span></a>
  </div>
</Layout>

<style is:global>
  .blog-content,
  .blog-content p,
  .blog-content li,
  .blog-content ul,
  .blog-content ol,
  .blog-content h2,
  .blog-content h3,
  .blog-content h4,
  .blog-content strong {
    color: #1e293b;
  }
  :root.dark .blog-content,
  :root.dark .blog-content p,
  :root.dark .blog-content li,
  :root.dark .blog-content h2,
  :root.dark .blog-content h3,
  :root.dark .blog-content h4,
  :root.dark .blog-content strong {
    color: #e2e8f0;
  }
  .blog-content a {
    color: #4f46e5;
    text-decoration: underline;
    font-weight: 500;
  }
  :root.dark .blog-content a {
    color: #818cf8;
  }
  .blog-content a:hover {
    color: #4338ca;
  }
  :root.dark .blog-content a:hover {
    color: #6366f1;
  }
</style>
