---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import fs from 'node:fs';
import blogPosts from '../../data/blog.json' with { type: 'json' };

const PER_PAGE = 10;

// Sort by date newest first
const sortedPosts = [...blogPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const totalPages = Math.ceil(sortedPosts.length / PER_PAGE);

export async function getStaticPaths() {
  const raw = JSON.parse(fs.readFileSync('src/data/blog.json', 'utf-8'));
  const posts = [...raw].sort(
    (a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime()
  );
  const tp = Math.ceil(posts.length / 10);
  const paths = [{ params: { page: undefined }, props: { pageNum: 1 } }];
  for (let i = 2; i <= tp; i++) {
    paths.push({ params: { page: String(i) }, props: { pageNum: i } });
  }
  return paths;
}

const { pageNum } = Astro.props;
const currentPage = pageNum;
const start = (currentPage - 1) * PER_PAGE;
const end = Math.min(start + PER_PAGE, sortedPosts.length);
const pagePosts = sortedPosts.slice(start, end);
---

<Layout
  title={currentPage === 1 ? "Game Guides & Tips - Chill Arcade Blog" : `Game Guides & Tips - Page ${currentPage} - Chill Arcade Blog`}
  description={currentPage === 1
    ? "Strategy guides, tips, and articles about your favorite casual games."
    : `Strategy guides, tips, and articles about your favorite casual games. Page ${currentPage} of ${totalPages}.`}
>
  <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 mb-2">🎮 <span data-i18n="nav.guides">Game Guides & Tips</span></h1>
  <p class="text-slate-500 dark:text-slate-400 mb-8 text-lg" data-i18n="blog.subtitle">Strategy guides, tips, and articles about your favorite casual games.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {pagePosts.map(post => (
      <a href={`/blog/${post.slug}`} class="block bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 hover:border-indigo-300 dark:hover:border-indigo-600 hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/50 px-2 py-1 rounded-full capitalize">{post.category}</span>
          <span class="text-xs text-slate-500">{post.date}</span>
          <span class="text-xs text-slate-500">{post.readTime} read</span>
        </div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-2">{post.title}</h2>
        <p class="text-sm text-slate-700 dark:text-slate-300">{post.description}</p>
      </a>
    ))}
  </div>

  {totalPages > 1 && (
    <section class="mt-10 mb-6">
      <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/blog" />
    </section>
  )}
</Layout>
