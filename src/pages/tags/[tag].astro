---
import Layout from '../../layouts/Layout.astro';
import GameGrid from '../../components/GameGrid.astro';
import allGames from '../../data/games.json' with { type: 'json' };

export async function getStaticPaths() {
  const tagSet = new Set<string>();
  (allGames as { tags?: string[] }[]).forEach(g => {
    if (g.tags) g.tags.forEach(t => tagSet.add(t));
  });
  return [...tagSet].sort().map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const tagGames = (allGames as { tags?: string[] }[]).filter(g => g.tags && g.tags.includes(tag));
const tagCapitalized = tag.charAt(0).toUpperCase() + tag.slice(1);
---

<Layout title={`Best Free ${tagCapitalized} Games Online - Chill Arcade`} description={`Play the best free ${tag} games online. Browse ${tagGames.length} ${tag} games, play instantly in your browser, no downloads needed.`}>
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300 font-medium capitalize">{tag} <span data-i18n="cat.games">Games</span></span>
  </nav>

  <div class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 mb-2">
      <span class="capitalize">{tag}</span> <span data-i18n="cat.games">Games</span>
    </h1>
    <p class="text-slate-500 dark:text-slate-400">
      <span class="font-semibold text-indigo-600 dark:text-indigo-400">{tagGames.length}</span> <span data-i18n="cat.games">games</span> tagged with "<span class="font-medium">{tag}</span>"
    </p>
  </div>

  <GameGrid games={tagGames} cols={8} compact={true} />

  <section class="mt-12 p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-3">
      Free <span class="capitalize">{tag}</span> Games Online
    </h2>
    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
      Browse our collection of {tagGames.length} free {tag} games. All games are optimized for mobile and desktop,
      load instantly in your browser, and are completely free to play. No download required, no signup needed.
    </p>
  </section>
</Layout>
