---
import Layout from '../../../layouts/Layout.astro';
import SearchAutocomplete from '../../../components/SearchAutocomplete.astro';
import GameCard from '../../../components/GameCard.astro';
import Pagination from '../../../components/Pagination.astro';
import type { Game, Category } from '../../../data/games';
import categoriesObj from '../../../data/categories.json' with { type: 'json' };
import allGames from '../../../data/games.json' with { type: 'json' };

const PER_PAGE = 96;

export async function getStaticPaths() {
  const PER_PAGE = 96;
  const categoryEntries = Object.entries(categoriesObj) as [string, Record<string, unknown>][];
  const paths: { params: Record<string, string | undefined>; props: Record<string, unknown> }[] = [];
  for (const [slug] of categoryEntries) {
    const catGames = (allGames as Game[]).filter((g: Game) => g.category === slug);
    const totalPages = Math.ceil(catGames.length / PER_PAGE);
    // First page: /category/{slug}
    paths.push({ params: { category: slug, page: undefined }, props: { categorySlug: slug, pageNum: 1 } });
    // Subsequent pages: /category/{slug}/{page}
    for (let i = 2; i <= totalPages; i++) {
      paths.push({ params: { category: slug, page: String(i) }, props: { categorySlug: slug, pageNum: i } });
    }
  }
  return paths;
}

const { categorySlug, pageNum } = Astro.props as { categorySlug: string; pageNum: number };
const category = categoriesObj[categorySlug];
const categoryGames = (allGames as Game[]).filter((g: Game) => g.category === categorySlug);
const totalPages = Math.ceil(categoryGames.length / PER_PAGE);
const currentPage = pageNum as number;
const start = (currentPage - 1) * PER_PAGE;
const end = Math.min(start + PER_PAGE, categoryGames.length);
const pageGames = categoryGames.slice(start, end);

const pageTitle = currentPage === 1
  ? `${category?.name || categorySlug} Games - Play Free Online`
  : `${category?.name || categorySlug} Games - Page ${currentPage} - Play Free Online`;
const pageDesc = currentPage === 1
  ? (category?.description || `Free ${categorySlug} games to play online`)
  : `Free ${categorySlug} games - page ${currentPage} of ${totalPages}. Play online instantly.`;
const canonical = currentPage === 1 ? `/category/${categorySlug}` : undefined;

// 预计算标签数据
const tagCN = {
  'action': '动作', 'adventure': '冒险', 'animals': '动物', 'arcade': '街机',
  'baseball': '棒球', 'basketball': '篮球', 'bike': '摩托', 'block': '方块',
  'board': '桌游', 'boat': '船', 'bubble': '泡泡', 'building': '建造',
  'car': '汽车', 'card': '纸牌', 'casual': '休闲', 'christmas': '圣诞',
  'city': '城市', 'coloring': '涂色', 'cooking': '烹饪', 'decorating': '装饰',
  'dress-up': '换装', 'driving': '驾驶', 'educational': '教育', 'endless': '无尽',
  'fantasy': '幻想', 'farming': '农场', 'fighting': '格斗', 'flying': '飞行',
  'football': '足球', 'golf': '高尔夫', 'halloween': '万圣节', 'hidden-object': '寻物',
  'idle': '挂机', 'io': 'IO', 'jump': '跳跃', 'magic': '魔法', 'match-3': '三消',
  'math': '数学', 'memory': '记忆', 'merge': '合成', 'multiplayer': '多人',
  'music': '音乐', 'ocean': '海洋', 'physics': '物理', 'puzzle': '益智',
  'racing': '竞速', 'shooting': '射击', 'simulation': '模拟', 'snow': '雪地',
  'space': '太空', 'sports': '体育', 'strategy': '策略', 'summer': '夏日',
  'survival': '生存', 'tennis': '网球', 'word': '文字', 'zombie': '僵尸',
};
const tagCounts: Record<string, number> = {};
for (const g of allGames) {
  if (g.tags) {
    for (const t of g.tags) {
      tagCounts[t] = (tagCounts[t] || 0) + 1;
    }
  }
}
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 24);
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <a href="/games" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.browse">All Games</a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300 capitalize"><span data-i18n={`cat.${categorySlug}`}>{category?.name || categorySlug}</span></span>
  </nav>

  <!-- Category Header -->
  <div class="mb-6">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-3">
          <span>{category?.icon || '🎮'}</span>
          <span><span data-i18n={`cat.${categorySlug}`}>{category?.name || categorySlug}</span> <span data-i18n="cat.games">Games</span></span>
        </h1>
        <p class="text-slate-500 dark:text-slate-400 mt-2">{pageDesc}</p>
        <p class="text-sm text-slate-400 mt-1">
          <span class="font-semibold text-indigo-600 dark:text-indigo-400">{categoryGames.length}</span> <span data-i18n="cat.games">games</span>
          {totalPages > 1 && <span> &mdash; page {currentPage} of {totalPages}</span>}
        </p>
      </div>
    </div>
  </div>

  <!-- Search & Filter -->
  <section class="mb-6">
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3">
      <div class="flex flex-col sm:flex-row gap-2">
        <SearchAutocomplete />
      </div>
      <div id="search-results-info" class="mt-1 text-xs text-slate-400 hidden">
        <span id="result-count">0</span> <span data-i18n="search.found">games found</span>
      </div>
    </div>
    <div id="tag-filter" class="flex flex-wrap gap-1.5 mt-2">
      {topTags.map(([tag, count]) => (
        <button data-tag={tag} data-cn={tagCN[tag] || tag} class="tag-chip px-2.5 py-1 text-xs font-medium rounded-full border border-slate-200 dark:border-slate-600 text-slate-500 dark:text-slate-400 hover:border-indigo-300 dark:hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all whitespace-nowrap">
          {tag} ({count})
        </button>
      ))}
    </div>
  </section>

  <!-- Dynamic search results -->
  <div id="search-results" class="hidden mb-8" data-category-slug={categorySlug}>
    <div id="results-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-2"></div>
  </div>

  <!-- Game Grid (paginated) -->
  <section class="mb-8" id="games-section">
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-2">
      {pageGames.map((game, idx) => (
        <GameCard
          slug={game.slug}
          title={game.title}
          category={game.category}
          image={game.image}
          description={game.shortDescription}
          iframeUrl={game.iframeUrl}
          difficulty={game.difficulty}
          compact={true}
          priority={currentPage === 1 && idx < 24}
        />
      ))}
    </div>
  </section>

  <!-- Pagination -->
  {totalPages > 1 && (
    <section class="mb-8">
      <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`/category/${categorySlug}`} />
    </section>
  )}

  <!-- SEO text (only on page 1) -->
  {currentPage === 1 && (
    <section class="mt-8 p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
      <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-3">
        Free {category?.name || categorySlug} Games Online
      </h2>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        Play the best free {category?.name || categorySlug} games right in your browser.
        No download required, no signup needed. All {categorySlug} games are optimized for mobile and desktop,
        and are completely free to play. Bookmark your favorites and come back anytime!
      </p>
    </section>
  )}

  <!-- Game search data (lazy loaded when search/filter is used) -->
  <script is:inline>
    if (!window.__lazyLoadGamesData) {
      window.__gamesData = window.__gamesData || [];
      window.__gamesDataPromise = window.__gamesDataPromise || new Promise(function(r){ window.__resolveGamesData = r; });
      window.__lazyLoadGamesData = function() {
        if (!window.__lazyLoadGamesData__pending) {
          window.__lazyLoadGamesData__pending = true;
          fetch('/search-data.json')
            .then(function(r) { return r.json(); })
            .then(function(d) {
              window.__gamesData = d;
              if (window.__resolveGamesData) window.__resolveGamesData(d);
              return d;
            })
            .catch(function() {
              window.__gamesData = [];
              if (window.__resolveGamesData) window.__resolveGamesData([]);
              return [];
            });
        }
        return window.__gamesDataPromise;
      };
    }
  </script>
</Layout>

<script>
  window.__initPage = function() {
  const searchInput = document.getElementById('search-input');
  const tagFilter = document.getElementById('tag-filter');
  const resultsInfo = document.getElementById('search-results-info');
  const resultCount = document.getElementById('result-count');
  const searchResults = document.getElementById('search-results');
  const resultsGrid = document.getElementById('results-grid');
  const gamesSection = document.getElementById('games-section');

  const categorySlug = searchResults?.getAttribute('data-category-slug') || '';
  let selectedTag = '';
  let allGamesData = window.__gamesData || [];

  // When search data loads, re-run any active filter
  (window.__gamesDataPromise || Promise.resolve([])).then(function(data) {
    allGamesData = data;
    if (searchInput?.value || selectedTag) {
      filterGames();
    }
  });

  // 标签点击筛选（标签按钮已预渲染，只需事件绑定）
  tagFilter?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tag]');
    if (!btn) return;
    const tag = btn.getAttribute('data-tag');
    if (selectedTag === tag) {
      selectedTag = '';
      btn.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
      btn.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
    } else {
      tagFilter.querySelectorAll('[data-tag]').forEach(b => {
        b.classList.remove('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
        b.classList.add('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
      });
      selectedTag = tag;
      btn.classList.remove('border-slate-200','dark:border-slate-600','text-slate-500','dark:text-slate-400');
      btn.classList.add('bg-indigo-100','dark:bg-indigo-900/30','border-indigo-400','text-indigo-700','dark:text-indigo-300');
    }
    filterGames();
  });

  // 语言切换时更新标签文字
  function updateTagLabels() {
    const lang = localStorage.getItem('i18n_lang') || 'en';
    tagFilter?.querySelectorAll('[data-tag][data-cn]').forEach(el => {
      const en = el.getAttribute('data-tag');
      const cn = el.getAttribute('data-cn');
      const count = el.textContent.match(/\((\d+)\)/);
      const cnt = count ? count[1] : '';
      const label = (lang === 'zh' || lang === 'zh-tw') ? (cn || en) : en;
      el.textContent = label + ' (' + cnt + ')';
    });
  }
  updateTagLabels();

  function renderResults(games) {
    if (!resultsGrid || !searchResults) return;
    if (games.length === 0) {
      resultsGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg mb-1">🔍</p><p data-i18n="search.noresults">No games found. Try a different search.</p></div>';
      return;
    }
    const emojiMap = {'match-3':'🍬','puzzle':'🧩','merge':'🧪','casual':'🎮','arcade':'👾','word':'🔤','card':'🃏','hidden-object':'🔍','board':'♟️','strategy':'🎯','adventure':'⚔️','sports':'⚽','racing':'🏎️','action':'🎯','fighting':'🥊','multiplayer':'👥','idle':'📈'};
    resultsGrid.innerHTML = games.map(g => `
      <a href="/games/${g.slug}" class="gc">
        <div class="gc-thumb">
          ${g.image
            ? `<img src="${g.image}" alt="${g.title}" loading="lazy" decoding="async" />`
            : `<span class="gc-icon">${emojiMap[g.category] || '🎮'}</span>`
          }
          <div class="gc-overlay">
            <div class="gc-play">
              <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <span class="gc-title">${g.title}</span>
      </a>
    `).join('');
    resultsGrid.querySelectorAll('.gc').forEach(function(el) {
      if (!el.classList.contains('visible')) el.classList.add('visible');
    });
  }

  function filterGames() {
    if (window.__lazyLoadGamesData) window.__lazyLoadGamesData();
    const query = (searchInput?.value || '').trim().toLowerCase();
    const isActive = query || selectedTag;

    const filtered = allGamesData.filter(g => {
      const matchTag = !selectedTag || (g.tags && g.tags.includes(selectedTag));
      const matchSearch = !query ||
        g.title.toLowerCase().includes(query) ||
        g.description.toLowerCase().includes(query) ||
        g.category.includes(query) ||
        (g.tags && g.tags.some(t => t.includes(query)));
      return matchCategory(g) && matchTag && matchSearch;
    });

    function matchCategory(g) {
      // On a category page, we only show games in this category
      return g.category === categorySlug;
    }

    if (resultsInfo && resultCount) {
      if (isActive) {
        resultsInfo.classList.remove('hidden');
        resultCount.textContent = filtered.length;
      } else {
        resultsInfo.classList.add('hidden');
      }
    }

    if (isActive && searchResults && resultsGrid) {
      searchResults.classList.remove('hidden');
      if (gamesSection) gamesSection.style.display = 'none';
      renderResults(filtered);
    } else {
      if (searchResults) searchResults.classList.add('hidden');
      if (gamesSection) gamesSection.style.display = '';
    }
  }

  searchInput?.addEventListener('input', filterGames);

  document.addEventListener('i18nchange', updateTagLabels);
  };
  window.__initPage();
</script>
