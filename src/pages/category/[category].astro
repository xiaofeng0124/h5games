---
import Layout from '../../layouts/Layout.astro';
import GameGrid from '../../components/GameGrid.astro';
import type { Game } from '../../data/games';
import type { Category } from '../../data/games';
import categoriesObj from '../../data/categories.json' with { type: 'json' };
import allGames from '../../data/games.json' with { type: 'json' };

export async function getStaticPaths() {
  const catEntries = Object.entries(categoriesObj) as [string, unknown][];
  return catEntries.map(([slug]) => ({
    params: { category: slug },
    props: { categorySlug: slug },
  }));
}

const { categorySlug } = Astro.props;
const cats = categoriesObj as Record<string, Category>;
const category = cats[categorySlug];
const categoryGames = (allGames as Game[]).filter((g: Game) => g.category === categorySlug);
---

<Layout title={`${category?.name || categorySlug} Games - Play Free Online`} description={category?.description}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" data-i18n="nav.home">Home</a>
    <span>/</span>
    <span class="text-slate-700 dark:text-slate-300 capitalize">{category?.name || categorySlug} Games</span>
  </nav>

  <!-- Category Header -->
  <div class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-3">
      <span>{category?.icon || '🎮'}</span>
      <span>{category?.name || categorySlug} Games</span>
    </h1>
    <p class="text-slate-500 dark:text-slate-400 mt-2 text-lg">
      {category?.description || `Free ${categorySlug} games to play online`}
    </p>
    <p class="text-sm text-slate-400 mt-1">{categoryGames.length} games</p>
  </div>

  <!-- Game List -->
  <GameGrid games={categoryGames} cols={3} />

  <!-- SEO text -->
  <section class="mt-12 p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-3">
      Free {category?.name || categorySlug} Games Online
    </h2>
    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
      Play the best free {category?.name || categorySlug} {categoryGames.length > 1 ? 'games' : 'game'} right in your browser.
      No download required, no signup needed. All {categorySlug} games are optimized for mobile and desktop,
      load instantly, and are completely free to play. Bookmark your favorites and come back anytime!
    </p>
  </section>
</Layout>
