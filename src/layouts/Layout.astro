---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { title, description, image, canonical } = Astro.props;
const siteTitle = title ? `${title} | Chill Arcade` : 'Chill Arcade';
const siteDesc = description || 'Play free relaxing online games in your browser. No download, no signup, instant fun!';
const siteImage = image
  ? (image.startsWith('http') ? image : new URL(image, Astro.site).href)
  : new URL('/og-default.png', Astro.site).href;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDesc} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:image" content={siteImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDesc} />
    <meta name="twitter:image" content={siteImage} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="dns-prefetch" href="https://html5.gamedistribution.com" />
    <link rel="dns-prefetch" href="https://img.gamedistribution.com" />
    <link rel="dns-prefetch" href="https://html5.gamemonetize.co" />
    <link rel="dns-prefetch" href="https://img.gamemonetize.com" />
    <link rel="dns-prefetch" href="https://img.gamepix.com" />
    <link rel="dns-prefetch" href="https://play.gamepix.com" />
    <link rel="preconnect" href="https://html5.gamedistribution.com" />
    <link rel="preconnect" href="https://img.gamedistribution.com" crossorigin />
    <link rel="preconnect" href="https://html5.gamemonetize.co" />
    <link rel="preconnect" href="https://img.gamemonetize.com" crossorigin />
    <link rel="preconnect" href="https://img.gamepix.com" crossorigin />
    <link rel="preconnect" href="https://play.gamepix.com" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />

    <!-- i18n support -->

    <title>{siteTitle}</title>

    <!-- Cloudflare Web Analytics (privacy-first, no cookies) -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6f01648ac96340dfa19a805a19941cdc"}'></script>
  </head>
  <body class="min-h-screen text-slate-800 dark:text-slate-100">
    <Header />
    <main class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>
    <button id="back-to-top" aria-label="Back to top"
      class="fixed bottom-6 right-6 z-50 w-10 h-10 flex items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-300/50 dark:shadow-indigo-900/30 opacity-0 translate-y-4 invisible transition-all duration-300 hover:bg-indigo-700 hover:scale-110">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
    </button>
    <Footer />
    <CookieConsent />
    <script is:inline>
(function(){
  'use strict';
  var lang = localStorage.getItem('i18n_lang') || 'en';
  var trans = null;
  var langs = null;

  function load(cb) {
    if (trans) { cb(); return; }
    try {
      var cached = JSON.parse(localStorage.getItem('i18n_cache'));
      if (cached && cached.translations && cached.languages) {
        trans = cached.translations;
        langs = cached.languages;
        cb();
        fetch('/i18n/translations.json?' + Date.now())
          .then(function(r) { return r.json(); })
          .then(function(d) {
            trans = d.translations;
            langs = d.languages;
            try { localStorage.setItem('i18n_cache', JSON.stringify(d)); } catch(ex) {}
            apply(lang);
          })
          .catch(function() {});
        return;
      }
    } catch(ex) {}
    fetch('/i18n/translations.json?' + Date.now())
      .then(function(r) { return r.json(); })
      .then(function(d) {
        trans = d.translations;
        langs = d.languages;
        try { localStorage.setItem('i18n_cache', JSON.stringify(d)); } catch(ex) {}
        cb();
      })
      .catch(function() { cb(); });
  }

  function apply(l) {
    lang = l;
    localStorage.setItem('i18n_lang', l);
    if (!trans) return;
    var els = document.querySelectorAll('[data-i18n]');
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      var key = el.getAttribute('data-i18n');
      if (!key || !trans[key]) continue;
      var text = trans[key][l] || trans[key].en || key;
      var cnt = el.getAttribute('data-i18n-count');
      if (cnt && text.indexOf('{count}') >= 0) text = text.split('{count}').join(cnt);
      if (el.getAttribute('data-i18n-attr') === 'placeholder') {
        el.placeholder = text;
      } else if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
        el.value = text;
      } else if (el.tagName === 'OPTION') {
        el.text = text;
      } else {
        el.textContent = text;
      }
    }
    document.documentElement.lang = l;
    var info = null;
    if (langs) {
      for (var j = 0; j < langs.length; j++) {
        if (langs[j].code === l) { info = langs[j]; break; }
      }
    }
    document.documentElement.dir = (info && info.dir) ? info.dir : 'ltr';
    var flag = document.getElementById('lang-flag');
    var name = document.getElementById('lang-name');
    if (flag && name && info) {
      flag.src = '/flags/' + (info.country || 'us') + '.svg';
      name.textContent = info.nativeName;
    }
    var menu = document.getElementById('lang-selector-menu');
    if (menu) { menu.classList.add('hidden'); menu.classList.remove('grid'); }
    var btns = document.querySelectorAll('[data-lang-code]');
    for (var k = 0; k < btns.length; k++) {
      var code = btns[k].getAttribute('data-lang-code');
      if (code === l) {
        btns[k].classList.add('ring-2','ring-indigo-500','bg-indigo-50','dark:bg-indigo-900/30');
      } else {
        btns[k].classList.remove('ring-2','ring-indigo-500','bg-indigo-50','dark:bg-indigo-900/30');
      }
    }
    document.dispatchEvent(new CustomEvent('i18nchange', {detail: {lang: l}}));
  }

  function initUI() {
    var btn = document.getElementById('lang-selector-btn');
    var menu = document.getElementById('lang-selector-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      menu.classList.toggle('hidden');
      menu.classList.toggle('grid');
    });
    menu.addEventListener('click', function(e) {
      var t = e.target.closest('[data-lang-code]');
      if (t) apply(t.getAttribute('data-lang-code'));
    });
    document.addEventListener('click', function() {
      menu.classList.add('hidden');
      menu.classList.remove('grid');
    });
    var btns = document.querySelectorAll('[data-lang-code]');
    for (var i = 0; i < btns.length; i++) {
      if (btns[i].getAttribute('data-lang-code') === lang) {
        btns[i].classList.add('ring-2','ring-indigo-500','bg-indigo-50','dark:bg-indigo-900/30');
      }
    }
  }

  window.__ = function(key) {
    if (!trans || !trans[key]) return key;
    return trans[key][lang] || trans[key].en || key;
  };

  load(function() { apply(lang); initUI(); });
})();
    </script>
  </body>
</html>

<script>
  (function() {
    function updateTheme() {
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
    updateTheme();
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateTheme);
  })();

  // Back to top button
  const btn = document.getElementById('back-to-top');
  if (btn) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 300) {
        btn.classList.remove('invisible', 'opacity-0', 'translate-y-4');
        btn.classList.add('opacity-100', 'translate-y-0');
      } else {
        btn.classList.add('invisible', 'opacity-0', 'translate-y-4');
        btn.classList.remove('opacity-100', 'translate-y-0');
      }
    }, { passive: true });
    btn.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
