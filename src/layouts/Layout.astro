---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { title, description, image, canonical } = Astro.props;
const siteTitle = title ? `${title} | Chill Arcade` : 'Chill Arcade';
const siteDesc = description || 'Play free relaxing online games in your browser. No download, no signup, instant fun!';
const siteImage = image
  ? (image.startsWith('http') ? image : new URL(image, Astro.site).href)
  : new URL('/og-default.png', Astro.site).href;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDesc} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:image" content={siteImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDesc} />
    <meta name="twitter:image" content={siteImage} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="dns-prefetch" href="https://html5.gamedistribution.com" />
    <link rel="dns-prefetch" href="https://img.gamedistribution.com" />
    <link rel="preconnect" href="https://html5.gamedistribution.com" />
    <link rel="preconnect" href="https://img.gamedistribution.com" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />

    <!-- i18n support -->

    <title>{siteTitle}</title>

    <!-- Cloudflare Web Analytics (privacy-first, no cookies) -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6f01648ac96340dfa19a805a19941cdc"}'></script>
  </head>
  <body class="min-h-screen text-slate-800 dark:text-slate-100">
    <Header />
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>
    <button id="back-to-top" aria-label="Back to top"
      class="fixed bottom-6 right-6 z-50 w-10 h-10 flex items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-300/50 dark:shadow-indigo-900/30 opacity-0 translate-y-4 invisible transition-all duration-300 hover:bg-indigo-700 hover:scale-110">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
    </button>
    <Footer />
    <CookieConsent />
    <script is:inline>
(function(){'use strict';var e=localStorage.getItem('i18n_lang')||'en',t=null,n=null;function r(r){if(t){r();return}fetch('/i18n/translations.json?'+Date.now()).then(function(e){return e.json()}).then(function(e){t=e.translations,n=e.languages,r()}).catch(function(){r()})}function o(r){e=r,localStorage.setItem('i18n_lang',r);if(!t)return;var o=document.querySelectorAll('[data-i18n]');for(var i=0;i<o.length;i++){var a=o[i],u=a.getAttribute('data-i18n');if(!u||!t[u])continue;var f=t[u][r]||t[u].en||u;if(a.getAttribute('data-i18n-attr')==='placeholder')a.placeholder=f;else if(a.tagName==='INPUT'||a.tagName==='TEXTAREA')a.value=f;else a.textContent=f}var s=document.documentElement;s.lang=r;var c=null;if(n)for(var l=0;l<n.length;l++){if(n[l].code===r){c=n[l];break}}c&&c.dir?s.dir=c.dir:s.dir='ltr';var d=document.getElementById('lang-flag'),v=document.getElementById('lang-name');if(d&&v&&c){d.src='/flags/'+(c.country||'us')+'.svg';v.textContent=c.nativeName}var g=document.getElementById('lang-selector-menu');if(g){g.classList.add('hidden');g.classList.remove('grid')}var p=document.querySelectorAll('[data-lang-code]');for(var h=0;h<p.length;h++){var m=p[h].getAttribute('data-lang-code');if(m===r)p[h].classList.add('ring-2','ring-indigo-500','bg-indigo-50','dark:bg-indigo-900/30');else p[h].classList.remove('ring-2','ring-indigo-500','bg-indigo-50','dark:bg-indigo-900/30')}}function i(){var t=document.getElementById('lang-selector-btn'),n=document.getElementById('lang-selector-menu');if(!t||!n)return;t.addEventListener('click',function(e){e.stopPropagation();n.classList.toggle('hidden');n.classList.toggle('grid')});n.addEventListener('click',function(e){var n=e.target.closest('[data-lang-code]');if(n)o(n.getAttribute('data-lang-code'))});document.addEventListener('click',function(){n.classList.add('hidden');n.classList.remove('grid')});var r=document.querySelectorAll('[data-lang-code]');for(var a=0;a<r.length;a++){if(r[a].getAttribute('data-lang-code')===e)r[a].classList.add('ring-2','ring-indigo-500','bg-indigo-50','dark:bg-indigo-900/30')}}window.__=function(n){if(!t||!t[n])return n;return t[n][e]||t[n].en||n};r(function(){o(e);i()})})();
    </script>
  </body>
</html>

<script>
  (function() {
    function updateTheme() {
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
    updateTheme();
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateTheme);
  })();

  // Back to top button
  const btn = document.getElementById('back-to-top');
  if (btn) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 300) {
        btn.classList.remove('invisible', 'opacity-0', 'translate-y-4');
        btn.classList.add('opacity-100', 'translate-y-0');
      } else {
        btn.classList.add('invisible', 'opacity-0', 'translate-y-4');
        btn.classList.remove('opacity-100', 'translate-y-0');
      }
    }, { passive: true });
    btn.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
